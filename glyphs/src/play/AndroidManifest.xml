<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play build type of Core Builds Glyphs Pack. Leanback is required,
     as in the icon pack's Play build (app/src/play/AndroidManifest.xml):
     with it optional Play offers the app to phones, and its listing, like
     the pack's, is TV-only.

     Lint reads this overlay on its own and misses the TV launcher entry and
     the optional touchscreen that src/main declares; the merged Play
     manifest has both (tests/test_play_build.py checks src/main for them). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher,ImpliedTouchscreenHardware">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true"
        tools:replace="android:required" />

</manifest>
