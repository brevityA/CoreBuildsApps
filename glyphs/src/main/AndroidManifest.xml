<?xml version="1.0" encoding="utf-8"?>
<!--
  Core Builds Glyphs: a resource pack with a front door.

  Two activities, on purpose, because they need different windows:

    .GlyphsActivity      translucent, no UI. Carries the icon-pack discovery
                         intent filters launchers look for, forwards
                         ACTION_PICK_ICON requests to the icon pack and
                         finishes. It must stay translucent: a pick is
                         answered by the other package, and an opaque window
                         here would flash on every forward.

    .GlyphsHomeActivity  the drawer / Android TV row entry. What a user sees
                         when they open the pack: what it is, how many icons
                         it covers, and the way through to the icon pack
                         where the Art style toggle lives.

  The discovery filters stay on .GlyphsActivity so that the set of launchers
  that can find this pack is exactly the set that can find the icon pack;
  tests/test_glyphs_pack.py holds the two sets equal and holds the MAIN filter
  solo on the home activity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: the icon-picker forward and the home
         screen's Open button both start an activity in the icon pack, which
         must be visible to do that. -->
    <queries>
        <package android:name="tv.corebuilds.iconpack" />
    </queries>

    <!-- Declared now that there is a launcher entry to put on the TV row.
         required=false: sideloaded installs do not filter on features, and
         the pack is useful on a phone launcher too. Lint reads this
         declaration as a promise of a LEANBACK_LAUNCHER activity, which
         .GlyphsHomeActivity below is. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/cb_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher">

        <activity
            android:name=".GlyphsHomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/GlyphsHome">

            <!-- Same grammar as the icon pack's own launcher filter, so the
                 companion lands in a phone drawer and on a TV row exactly
                 where the pack does. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GlyphsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">

            <intent-filter>
                <action android:name="com.gau.go.launcherex.theme" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.spocky.projengmenu.icons.ACTION_PICK_ICON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.sonymobile.home.ICON_PACK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.fede.launcher.THEME_ICONPACK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="ch.deletescape.lawnchair.PICK_ICON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="net.oneplus.launcher.icons.ACTION_PICK_ICON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.phonemetra.turbo.launcher.icons.ACTION_PICK_ICON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <category android:name="com.novalauncher.category.CUSTOM_ICON_PICKER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.novalauncher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.anddoes.launcher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="ch.deletescape.lawnchair.ICONPACK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.teslacoilsw.launcher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="com.novalauncher.Theme"
                android:value="true" />
        </activity>
    </application>
</manifest>
