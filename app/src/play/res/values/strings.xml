<?xml version="1.0" encoding="utf-8"?>
<!-- Play build wording: what the Play build actually sends, where its
     updates come from, and what the Core Premium card sells (Plus in code).
     Play's Device and Network Abuse policy rules out the GitHub update row,
     so About's row opens this app's Play listing; its Payments policy rules
     out the Ko-fi and Sponsors codes, so SupportActivity is the Core Premium
     card over Play Billing, reached from Settings > Core Premium and never
     from a Support door.

     This overlay must keep the main list's shape, item for item: Play replaces
     the update item and the wallpaper item, but the missing-icon report on
     item 3 is the same POST in both builds, so main's about_network_three is
     inherited unchanged. tests/test_play_build.py holds that. -->
<resources>
    <string name="about_network_one">1.  Nothing for updates: Google Play updates this app.</string>
    <string name="about_network_two">2.  A request for each wallpaper or live loop you choose to download. Core Builds Glyphs Pack comes from its own Google Play listing.</string>
    <string name="about_update_label">Updates from Google Play</string>
    <string name="about_update_sub">Google Play updates this app. Press to open its listing.</string>

    <string name="support_label">Premium</string>
    <string name="support_kicker">PREMIUM</string>
    <string name="support_title">Core Premium</string>
    <!-- 2.6.0: the six extras are a list on the screen (plus_feature_* in
         main), so the body is the sentence over it. -->
    <string name="support_body">One purchase through Google Play adds six things:</string>
    <string name="support_mode">Optional. Every icon, the main wallpaper collection (in Projectivy\'s rotation too) and every screen ship to everyone; Premium adds the six things above.</string>
    <string name="support_footer">Price and payment come from Google Play. Core Builds never sees your card or your Google account.</string>
</resources>
