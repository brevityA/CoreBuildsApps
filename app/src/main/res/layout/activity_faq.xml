<?xml version="1.0" encoding="utf-8"?>
<!--
  Troubleshooting and FAQ. Read-only cards: the repo's troubleshooting docs
  (WHY_PROJECTIVY_CANT_SEE_IT, DIRECT_APPLY, MONET_LAUNCHER, ADB_SCANNING)
  rendered for a sofa, because a Markdown file is not reachable from one.

  Same chrome grammar as Settings: pinned header with the back button, one
  ScrollView between header and bottom edge, scrollbar left visible so the
  screen says more content exists. Cards are NOT focusable - there is nothing
  to press inside them, and focusable read-only text is the D-pad trap where
  the ring lands on a paragraph and left/right do nothing.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="monospace"
                android:paddingStart="@dimen/cb_space_sm"
                android:paddingEnd="@dimen/cb_space_sm"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:letterSpacing="0.18"
                android:text="@string/faq_kicker"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_kicker"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cb_space_md"
                android:ellipsize="end"
                android:letterSpacing="-0.025"
                android:maxLines="1"
                android:text="@string/faq_title"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/faq_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/cb_button_min_width"
            android:minHeight="@dimen/cb_target_min"
            android:background="@drawable/bg_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingEnd="@dimen/cb_space_lg"
            android:text="@string/action_back"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_body" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/faq_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/cb_space_md"
            android:paddingBottom="@dimen/cb_space_xs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/cb_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq_cache_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/faq_cache_body"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/cb_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq_override_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/faq_override_body"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/cb_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq_monet_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/faq_monet_body"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/cb_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq_unmapped_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/faq_unmapped_body"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
