<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallpapers (2.6.0, rail and stage), Home's grammar.

  RAIL (cb_nav_rail_width, full height, the void colour): the SERIES heading
  over the series as rail rows - the chosen one cyan on a cyan tint - and at
  the rail's foot the export affordance: a ghost pill over the paragraph that
  says what it is for (Monet rotates Pictures/CoreBuilds). The list scrolls
  inside the rail, so the foot stays put with any number of series.

  STAGE (the remainder): the eyebrow, the title and the wall count, with Back
  at the right; the long-press selection bar under them (a mode, not chrome);
  then the thumb grid, three columns of named thumbs. Column count is derived
  in WallpapersActivity from the stage width and the tile pitch, so a 4K panel
  keeps the proportions.

  Focus, unchanged by the restyle and pinned in tests/test_ui_wiring.py:
  Back -> selection bar (hidden: skipped, focusable="false") -> series ->
  export pill down the rail, and Back -> grid across into the stage; the grid's
  own UP names Back and LEFT crosses to the series.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_night"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- RAIL: the series, then the export foot. -->
        <LinearLayout
            android:layout_width="@dimen/cb_nav_rail_width"
            android:layout_height="match_parent"
            android:background="@color/cb_void"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/cb_rail_pad_start"
            android:paddingEnd="@dimen/cb_rail_pad_end"
            android:paddingTop="@dimen/cb_stage_top"
            android:paddingBottom="@dimen/cb_stage_bottom">

            <TextView
                style="@style/CoreBuilds.MenuHeading"
                android:paddingStart="12dp"
                android:paddingBottom="@dimen/cb_space_xs"
                android:text="@string/wp_series_heading" />

            <!-- 0dp+weight: with a dozen series the list is taller than the
                 rail, and a wrap_content list would push the export foot off
                 the panel. Weighted, it scrolls inside the rail and the foot
                 stays put. -->
            <!-- The list clips its rows to its own bounds, so a half-shown row
                 fades under its edge instead of drawing over the export pill;
                 6dp of padding each side, given back by the margins, is the
                 room a focused row's 1.04 lift needs. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/wp_chips"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:fadingEdgeLength="@dimen/cb_space_lg"
                android:requiresFadingEdge="vertical"
                android:nextFocusUp="@id/wp_selection_bar"
                android:nextFocusDown="@id/wp_export"
                android:nextFocusRight="@id/wp_grid"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/wp_export"
                style="@style/Widget.CoreBuilds.Pill.Ghost.Wide"
                android:layout_marginTop="@dimen/cb_space_md"
                android:drawablePadding="10dp"
                android:nextFocusUp="@id/wp_chips"
                android:text="@string/wp_export_rail"
                app:drawableStartCompat="@drawable/ic_export"
                app:drawableTint="@color/pill_ghost_text" />

            <TextView
                android:id="@+id/wp_export_sub"
                style="@style/CoreBuilds.Lede"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/wp_export_sub"
                android:textSize="@dimen/cb_text_kicker" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/cb_divider" />

        <!-- STAGE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/cb_stage_start"
            android:paddingEnd="@dimen/cb_stage_end"
            android:paddingTop="@dimen/cb_stage_top"
            android:paddingBottom="@dimen/cb_stage_bottom">

            <!-- The stage clips its rows, so the header carries 4dp of its own
                 room (given back by the margins) for Back's focus lift. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CoreBuilds.Eyebrow"
                        android:text="@string/wp_kicker" />

                    <TextView
                        style="@style/CoreBuilds.Title"
                        android:text="@string/wp_entry" />

                    <TextView
                        android:id="@+id/wp_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_kicker" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wp_back"
                    style="@style/Widget.CoreBuilds.Pill.Ghost"
                    android:layout_height="@dimen/cb_pill_compact"
                    android:drawablePadding="6dp"
                    android:nextFocusDown="@id/wp_selection_bar"
                    android:paddingStart="12dp"
                    android:text="@string/wp_back"
                    app:drawableStartCompat="@drawable/ic_chevron_start"
                    app:drawableTint="@color/pill_ghost_text" />
            </LinearLayout>

            <!-- Contextual selection bar: hidden until the user long-presses a
                 tile. focusable="false" while gone so it can never hold the
                 cursor; the edges that name it are skipped by FocusFinder until
                 it is shown. -->
            <LinearLayout
                android:id="@+id/wp_selection_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:background="@drawable/bg_section"
                android:clipChildren="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:gravity="center_vertical"
                android:nextFocusUp="@id/wp_back"
                android:nextFocusDown="@id/wp_chips"
                android:orientation="horizontal"
                android:paddingStart="@dimen/cb_space_md"
                android:paddingEnd="@dimen/cb_space_xs"
                android:paddingTop="@dimen/cb_space_xs"
                android:paddingBottom="@dimen/cb_space_xs"
                android:visibility="gone">

                <TextView
                    android:id="@+id/wp_selection_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/cb_signal_cyan"
                    android:textSize="@dimen/cb_text_data" />

                <TextView
                    android:id="@+id/wp_select_all"
                    style="@style/Widget.CoreBuilds.Pill"
                    android:layout_height="@dimen/cb_pill_compact"
                    android:layout_marginEnd="@dimen/cb_space_xs"
                    android:nextFocusUp="@id/wp_back"
                    android:nextFocusDown="@id/wp_chips"
                    android:text="@string/wp_select_all" />

                <TextView
                    android:id="@+id/wp_clear"
                    style="@style/Widget.CoreBuilds.Pill"
                    android:layout_height="@dimen/cb_pill_compact"
                    android:layout_marginEnd="@dimen/cb_space_xs"
                    android:nextFocusUp="@id/wp_back"
                    android:nextFocusDown="@id/wp_chips"
                    android:text="@string/wp_clear" />

                <TextView
                    android:id="@+id/wp_export_selected"
                    style="@style/Widget.CoreBuilds.Pill.Cta"
                    android:layout_height="@dimen/cb_pill_compact"
                    android:nextFocusUp="@id/wp_back"
                    android:nextFocusDown="@id/wp_chips"
                    android:text="@string/wp_export" />
            </LinearLayout>

            <!-- The thumbs. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/wp_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/cb_space_md"
                android:clipToPadding="false"
                android:nextFocusUp="@id/wp_back"
                android:nextFocusDown="@id/wp_export"
                android:nextFocusLeft="@id/wp_chips" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
