<?xml version="1.0" encoding="utf-8"?>
<!--
  My requests, a Core Premium extra (Google Play build). The What's new
  grammar: header and summary pinned, the rows in a ScrollView the activity
  fills from RequestLog. Rows are focusable so the D-pad can scroll a long
  list; pressing one does nothing more. Back is the header's pill (2.6.0), as
  on every other screen, instead of a full-width row under the list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_night"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Eyebrow"
                android:text="@string/requests_kicker" />

            <TextView
                style="@style/CoreBuilds.Title"
                android:text="@string/settings_requests_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/requests_back"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_height="@dimen/cb_pill_compact"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            android:text="@string/action_back"
            app:drawableStartCompat="@drawable/ic_chevron_start"
            app:drawableTint="@color/pill_ghost_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/requests_summary"
        style="@style/CoreBuilds.Lede"
        android:layout_marginTop="@dimen/cb_space_xs" />

    <TextView
        android:id="@+id/requests_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_md"
        android:lineSpacingExtra="3dp"
        android:text="@string/requests_empty"
        android:textColor="@color/cb_ink"
        android:textSize="@dimen/cb_text_label"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/cb_space_md"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="-4dp"
        android:layout_marginEnd="-4dp">

        <LinearLayout
            android:id="@+id/requests_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
