<?xml version="1.0" encoding="utf-8"?>
<!--
  A section heading in the auditor list: what kind of gap the rows under it
  are, how many, and what pressing one of them files. Not focusable - the
  D-pad steps over it from row to row, the way it steps over every other
  kicker in the app.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingTop="@dimen/cb_space_md"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/audit_header_title"
        style="@style/CoreBuilds.MenuHeading"
        android:layout_width="match_parent" />

    <TextView
        android:id="@+id/audit_header_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />
</LinearLayout>
