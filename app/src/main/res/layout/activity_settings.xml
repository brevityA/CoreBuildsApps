<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings. Six rows, each one wired to a reader in SettingsActivity.

  TV focus: the row is the focusable target, not the switch inside it. The
  switches are focusable="false" clickable="false" so a D-pad makes one stop
  per setting instead of two, and the whole card takes the cyan ring from
  bg_card rather than a thumb lighting up inside an unhighlighted row.

  Scrolling: the rows live in a ScrollView, the header and footer are pinned
  outside it. The first version had no scroll container, on the reasoning that
  "four rows and a footer fit inside the safe area at 1080p". They do not. That
  was measured off a 1920x1080 mockup in pixels; Android lays out in dp, and a
  1080p TV reports 960x540dp. The rows came to roughly 615dp against 540dp
  available, and because the parent was a plain LinearLayout with a weight=1
  spacer, the overflow was silently clipped: the Clear button and the footer
  were off-screen with nothing on the panel to say so. A tester found it on the
  first install of the iconpack-test channel.

  The trims below (chip inline with the title instead of stacked above it,
  tighter section and row spacing, local gutters) bring the content to about
  520dp, so it fits at font scale 1.0 with roughly 20dp spare. That margin is
  thin on purpose: the ScrollView, not the trimming, is what makes this correct.
  Raise the TV's font scale and the screen scrolls instead of clipping.

  tests/test_tv_layout_fit.py keeps both halves honest. It re-derives these
  heights from the XML, fails any full-screen layout that overflows without a
  scroll container, and pins this file's ScrollView specifically.

  The old comment also worried that a scroll container would swallow D-pad down
  at the last row. It does not, for focusable children: ScrollView scrolls to
  whatever takes focus. It does strand trailing NON-focusable content, which is
  why the footer is pinned outside the scroll rather than sitting at its end.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <!-- HEADER: the eyebrow over the title, Back at the right (2.6.0, as on
         every screen). The rows below scroll, so the header's 53dp is paid
         for by the list rather than clipping it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_kicker" />

            <TextView
                style="@style/CoreBuilds.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/settings_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/set_back"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_width="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/action_back"
            android:layout_height="@dimen/cb_pill_compact"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            app:drawableStartCompat="@drawable/ic_chevron_start"
            app:drawableTint="@color/pill_ghost_text" />
    </LinearLayout>

    <!--
        Everything between the header and the footer scrolls. fillViewport keeps
        the content stretched to the viewport when it is shorter than the screen,
        so nothing floats mid-panel at font scale 1.0; clipToPadding=false lets
        the last row's 3dp focus ring clear the bottom edge while scrolled.

        The scrollbar is left visible. TV panels usually hide it, but the bug
        being fixed here was precisely that nothing on screen said more content
        existed, and it only draws when the content actually overflows.
    -->
    <ScrollView
        android:id="@+id/set_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/cb_space_xs">

