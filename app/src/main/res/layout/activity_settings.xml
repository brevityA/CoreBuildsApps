<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings. Four rows, each one wired to a reader in SettingsActivity.

  TV focus: the row is the focusable target, not the switch inside it. The
  switches are focusable="false" clickable="false" so a D-pad makes one stop
  per setting instead of two, and the whole card takes the cyan ring from
  bg_card rather than a thumb lighting up inside an unhighlighted row.

  Scrolling: the rows live in a ScrollView, the header and footer are pinned
  outside it. The first version had no scroll container, on the reasoning that
  "four rows and a footer fit inside the safe area at 1080p". They do not. That
  was measured off a 1920x1080 mockup in pixels; Android lays out in dp, and a
  1080p TV reports 960x540dp. The rows came to roughly 615dp against 540dp
  available, and because the parent was a plain LinearLayout with a weight=1
  spacer, the overflow was silently clipped: the Clear button and the footer
  were off-screen with nothing on the panel to say so. A tester found it on the
  first install of the iconpack-test channel.

  The trims below (chip inline with the title instead of stacked above it,
  tighter section and row spacing, local gutters) bring the content to about
  520dp, so it fits at font scale 1.0 with roughly 20dp spare. That margin is
  thin on purpose: the ScrollView, not the trimming, is what makes this correct.
  Raise the TV's font scale and the screen scrolls instead of clipping.

  tests/test_tv_layout_fit.py keeps both halves honest. It re-derives these
  heights from the XML, fails any full-screen layout that overflows without a
  scroll container, and pins this file's ScrollView specifically.

  The old comment also worried that a scroll container would swallow D-pad down
  at the last row. It does not, for focusable children: ScrollView scrolls to
  whatever takes focus. It does strand trailing NON-focusable content, which is
  why the footer is pinned outside the scroll rather than sitting at its end.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <!-- HEADER -->
    <!--
        gravity=center_vertical, not top. With the chip stacked above the title
        the left column was the tall side and top alignment was right; inline,
        the 48dp Back button is taller than the title, and top alignment left it
        hanging 10dp below the text it sits beside.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!--
            Chip beside the title, not stacked above it. About keeps the stacked
            form; this screen is a dense list and cannot spend 83dp on a header.
            Inline costs the height of the title alone.
        -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="monospace"
                android:paddingStart="@dimen/cb_space_sm"
                android:paddingEnd="@dimen/cb_space_sm"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:letterSpacing="0.18"
                android:text="@string/settings_kicker"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_kicker"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cb_space_md"
                android:ellipsize="end"
                android:letterSpacing="-0.025"
                android:maxLines="1"
                android:text="@string/settings_title"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/set_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/cb_button_min_width"
            android:minHeight="@dimen/cb_target_min"
            android:background="@drawable/bg_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingEnd="@dimen/cb_space_lg"
            android:text="@string/action_back"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_body" />
    </LinearLayout>

    <!--
        Everything between the header and the footer scrolls. fillViewport keeps
        the content stretched to the viewport when it is shorter than the screen,
        so nothing floats mid-panel at font scale 1.0; clipToPadding=false lets
        the last row's 3dp focus ring clear the bottom edge while scrolled.

        The scrollbar is left visible. TV panels usually hide it, but the bug
        being fixed here was precisely that nothing on screen said more content
        existed, and it only draws when the content actually overflows.
    -->
    <ScrollView
        android:id="@+id/set_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/cb_space_xs">

    <!-- UPDATES -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_md"
        android:fontFamily="monospace"
        android:letterSpacing="0.16"
        android:text="@string/settings_group_updates"
        android:textColor="@color/cb_signal_cyan"
        android:textSize="@dimen/cb_text_kicker"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/set_updates_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/cb_card_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_updates_title"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_updates_sub"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/set_updates_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:duplicateParentState="true" />
    </LinearLayout>

    <!-- DISPLAY -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_md"
        android:fontFamily="monospace"
        android:letterSpacing="0.16"
        android:text="@string/settings_group_display"
        android:textColor="@color/cb_signal_cyan"
        android:textSize="@dimen/cb_text_kicker"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/set_motion_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/cb_card_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_motion_title"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_motion_sub"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/set_motion_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:duplicateParentState="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/set_amoled_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/cb_card_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_amoled_title"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_amoled_sub"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/set_amoled_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:duplicateParentState="true" />
    </LinearLayout>

    <!-- STORAGE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_md"
        android:fontFamily="monospace"
        android:letterSpacing="0.16"
        android:text="@string/settings_group_storage"
        android:textColor="@color/cb_signal_cyan"
        android:textSize="@dimen/cb_text_kicker"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/cb_card_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_cache_title"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_cache_sub"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />
        </LinearLayout>

        <TextView
            android:id="@+id/set_cache_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/cb_space_md"
            android:fontFamily="monospace"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_label" />

        <TextView
            android:id="@+id/set_cache_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/cb_target_min"
            android:background="@drawable/bg_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingEnd="@dimen/cb_space_lg"
            android:text="@string/settings_cache_clear"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_label" />
    </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!--
        Footer pinned outside the scroll. It is not focusable, so inside the
        scroll a D-pad could never bring it into view once the content
        overflowed, which is the exact failure being fixed here.
    -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_xs"
        android:text="@string/settings_footer"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />

</LinearLayout>
