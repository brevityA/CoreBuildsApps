<?xml version="1.0" encoding="utf-8"?>
<!--
  About. Build facts on the left, the complete network list beneath them,
  links on the right.

  The network panel is the reason this screen exists. It is an enumeration,
  not a summary: if a third request is ever added, this list is wrong and has
  to be edited, which is exactly the friction wanted. A softer "we respect
  your privacy" line would stay true no matter what the app started doing.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="monospace"
                android:paddingStart="@dimen/cb_space_sm"
                android:paddingEnd="@dimen/cb_space_sm"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:letterSpacing="0.18"
                android:text="@string/about_kicker"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_kicker"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:letterSpacing="-0.025"
                android:text="@string/app_name"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/cb_button_min_width"
            android:minHeight="@dimen/cb_target_min"
            android:background="@drawable/bg_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingEnd="@dimen/cb_space_lg"
            android:text="@string/action_back"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_body" />
    </LinearLayout>

    <!-- BODY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/cb_space_lg"
        android:orientation="horizontal">

        <!-- LEFT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Build facts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="@dimen/cb_card_padding">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="@string/about_label_version"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_kicker" />

                    <TextView
                        android:id="@+id/about_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_title"
                        android:textStyle="bold" />

                    <!-- Verdict of the last Check for updates on this screen:
                         "LATEST" in cyan or "2.4.1 AVAILABLE" in the warning amber. GONE
                         until a check has run, so the fact stays a fact. -->
                    <TextView
                        android:id="@+id/about_version_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.10"
                        android:textColor="@color/cb_signal_cyan"
                        android:textSize="@dimen/cb_text_kicker"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="@string/about_label_build"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_kicker" />

                    <TextView
                        android:id="@+id/about_build"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_section" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="@string/about_label_icons"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_kicker" />

                    <TextView
                        android:id="@+id/about_icons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cb_signal_cyan"
                        android:textSize="@dimen/cb_text_section"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="@string/about_label_wallpapers"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_kicker" />

                    <TextView
                        android:id="@+id/about_wallpapers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cb_signal_cyan"
                        android:textSize="@dimen/cb_text_section"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- The whole network list -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/cb_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.14"
                    android:text="@string/about_network_header"
                    android:textColor="@color/cb_success"
                    android:textSize="@dimen/cb_text_kicker"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_sm"
                    android:text="@string/about_network_one"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_xs"
                    android:text="@string/about_network_two"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_sm"
                    android:text="@string/about_network_none"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT: links -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/cb_space_lg"
            android:minWidth="@dimen/cb_button_min_width"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:text="@string/about_links"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_kicker"
                android:textStyle="bold" />

            <!-- Check for updates: the same UpdateChecker the home screen runs
                 at startup, but on demand, with its answer written into the
                 sub-line - up to date, a version to download, or why GitHub
                 could not be reached - so a user whose checks are off in
                 Settings, or who pressed Later on the bar, still has a door.
                 The title doubles as the button through the whole flow:
                 Check -> Download vX -> Install vX. -->
            <LinearLayout
                android:id="@+id/about_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/cb_card_padding">

                <TextView
                    android:id="@+id/about_update_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_update_label"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_label" />

                <TextView
                    android:id="@+id/about_update_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/about_update_sub"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>

            <TextView
                android:id="@+id/about_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:text="@string/about_source_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label" />

            <TextView
                android:id="@+id/about_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:text="@string/about_settings_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label" />

            <TextView
                android:id="@+id/about_launcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:text="@string/about_launcher_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label" />

            <TextView
                android:id="@+id/about_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:text="@string/about_support_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/about_footer"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
