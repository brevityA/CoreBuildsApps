<?xml version="1.0" encoding="utf-8"?>
<!--
  About. Build facts on the left, the complete network list beneath them,
  links on the right.

  The network panel is the reason this screen exists. It is an enumeration,
  not a summary: if a third request is ever added, this list is wrong and has
  to be edited, which is exactly the friction wanted. A softer "we respect
  your privacy" line would stay true no matter what the app started doing.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom"
    android:clipToPadding="false">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_kicker" />

            <TextView
                style="@style/CoreBuilds.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/about_back"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_width="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/action_back"
            android:layout_height="@dimen/cb_pill_compact"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            app:drawableStartCompat="@drawable/ic_chevron_start"
            app:drawableTint="@color/pill_ghost_text" />
    </LinearLayout>

    <!-- BODY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/cb_space_md"
        android:orientation="horizontal">

        <!-- LEFT: the build facts and the network list. A ScrollView since
             2.6.0: the Google Play build lists a fourth request, and with
             Outfit's taller lines the list no longer fits the column at 1080p.
             The list is focusable, as Core EQ's information panels are, so
             the remote can enter it and scroll; LEFT from the links reaches it. -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Build facts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/cb_card_padding"
                android:background="@drawable/bg_row">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CoreBuilds.MenuHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_label_version" />

                    <TextView
                        android:id="@+id/about_version"
                        style="@style/CoreBuilds.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <!-- Verdict of the last Check for updates on this screen:
                         "LATEST" in cyan or "2.4.1 AVAILABLE" in the warning amber. GONE
                         until a check has run, so the fact stays a fact. -->
                    <TextView
                        android:id="@+id/about_version_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.10"
                        android:textColor="@color/cb_signal_cyan"
                        android:textSize="@dimen/cb_text_kicker"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CoreBuilds.MenuHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_label_build" />

                    <TextView
                        android:id="@+id/about_build"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_section" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CoreBuilds.MenuHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_label_icons" />

                    <TextView
                        android:id="@+id/about_icons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cb_signal_cyan"
                        android:textSize="@dimen/cb_text_section"
                        android:fontFamily="@font/outfit_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CoreBuilds.MenuHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_label_wallpapers" />

                    <TextView
                        android:id="@+id/about_wallpapers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cb_signal_cyan"
                        android:textSize="@dimen/cb_text_section"
                        android:fontFamily="@font/outfit_semibold" />
                </LinearLayout>
            </LinearLayout>

            <!-- The whole network list. Its items are 15sp, 6dp apart, since Outfit
                 (2.6.0) sets taller lines than Roboto and the list must fit the
                 column at 1080p (TextFitTest holds it). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:orientation="vertical"
                android:padding="@dimen/cb_card_padding"
                android:background="@drawable/bg_row"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:stateListAnimator="@animator/focus_raise">

                <TextView
                    style="@style/CoreBuilds.MenuHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_network_header"
                    android:textColor="@color/cb_success" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_sm"
                    android:text="@string/about_network_one"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_button" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/about_network_two"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_button" />

                <!-- The missing-icon report. It is the one request that carries
                     anything about the device, so it gets its own numbered item
                     rather than a clause on another. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/about_network_three"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_button" />

                <!-- Google Play build with Core Builds Plus on sale or owned:
                     My requests reads issue states from GitHub. -->
                <TextView
                    android:id="@+id/about_network_tracker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/about_network_tracker"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_button"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/about_network_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_sm"
                    android:text="@string/about_network_none"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>
        </LinearLayout>
        </ScrollView>

        <!-- RIGHT: links -->
        <LinearLayout
            android:layout_width="@dimen/cb_about_links_width"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/cb_space_lg"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.MenuHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_links" />

            <!-- Check for updates: the same UpdateChecker the home screen runs
                 at startup, but on demand, with its answer written into the
                 sub-line - up to date, a version to download, or why GitHub
                 could not be reached - so a user whose checks are off in
                 Settings, or who pressed Later on the bar, still has a door.
                 The title doubles as the button through the whole flow:
                 Check -> Download vX -> Install vX. -->
            <LinearLayout
                android:id="@+id/about_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/cb_card_padding"
                android:background="@drawable/bg_row"
                android:stateListAnimator="@animator/focus_raise">

                <TextView
                    android:id="@+id/about_update_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_update_label"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_label" />

                <TextView
                    android:id="@+id/about_update_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:text="@string/about_update_sub"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>

            <TextView
                android:id="@+id/about_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:text="@string/about_source_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label"
                android:background="@drawable/bg_row"
                android:stateListAnimator="@animator/focus_raise" />

            <!-- Google Play build only (AboutActivity shows it): testers' reports. -->
            <TextView
                android:id="@+id/about_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:text="@string/about_feedback_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label"
                android:background="@drawable/bg_row"
                android:stateListAnimator="@animator/focus_raise"
                android:visibility="gone" />

            <TextView
                android:id="@+id/about_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:text="@string/about_settings_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label"
                android:background="@drawable/bg_row"
                android:stateListAnimator="@animator/focus_raise" />

            <TextView
                android:id="@+id/about_launcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:text="@string/about_launcher_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label"
                android:background="@drawable/bg_row"
                android:stateListAnimator="@animator/focus_raise" />

            <TextView
                android:id="@+id/about_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:minHeight="@dimen/cb_target_min"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:text="@string/about_support_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label"
                android:background="@drawable/bg_row"
                android:stateListAnimator="@animator/focus_raise" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/about_footer"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
