<?xml version="1.0" encoding="utf-8"?>
<!--
  The suite hub. Header plus one scroll column; SuiteActivity inflates the
  six companion rows into suite_rows at creation, so the column's focus chain
  is exactly the rows you can see - no recycler, no hidden stops.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suite_kicker" />

            <TextView
                style="@style/CoreBuilds.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/suite_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/suite_back"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_width="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/action_back"
            android:layout_height="@dimen/cb_pill_compact"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            app:drawableStartCompat="@drawable/ic_chevron_start"
            app:drawableTint="@color/pill_ghost_text" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/suite_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/suite_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/cb_space_md"
            android:paddingBottom="@dimen/cb_space_xs" />
    </ScrollView>
</LinearLayout>
