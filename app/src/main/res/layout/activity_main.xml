<?xml version="1.0" encoding="utf-8"?>
<!--
  Home (2.6.0, rail and stage), Core EQ 1.12's grammar on the catalogue.

  RAIL (cb_nav_rail_width, full height, the void colour): the wordmark and the
  icon/component count, the Apply pill with the detected launchers under it and
  the ALSO APPLIES TO chips, then the rows - Art style, Missing icons and
  Wallpapers, each with the line that says its state - and at the rail's foot
  Support, Settings and About. A hairline separates it from the stage.

  STAGE (the remainder): the update bar when a newer build exists, the picker
  hint in icon-picker mode, the search pill, the category chips and the glyph
  grid, which takes every dp the chrome above it leaves. The grid's column
  count is derived in MainActivity from the stage width, the tile pitch and
  cb_tile_min_width, so a 4K panel keeps the proportions (TvActivity
  normalises every panel to the 960x540dp box first).

  The update bar used to span both panes above the rail; on the stage it takes
  its height from the grid, never from the rail, so the rail no longer has to
  give rows up while it is shown.

  Focus: two columns. The rail, top to bottom: apply_button -> apply_targets
  (when shown) -> style_entry -> missing_entry -> wallpapers_entry ->
  support_entry -> settings_entry -> about_entry. The stage, top to bottom:
  update_bar (when shown) -> search -> chip_row -> grid. LEFT/RIGHT cross
  between them geometrically. update_bar and apply_targets_band are GONE unless
  something shows them and focusable="false" while hidden, because
  isFocusable() ignores visibility and a hidden focusable stop strands the
  cursor - see MainActivity.syncFocusChain(), which rewrites every edge that
  routes through them at the moment their visibility changes.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- RAIL. A ScrollView, because the rail's height depends on what the
             device shows: the launcher note under Apply runs to five lines
             with no supported launcher, and ALSO APPLIES TO adds a band with a
             second one. A ScrollView scrolls to whatever takes focus, so D-pad
             DOWN always lands on a visible row; when everything fits it is
             inert, and fillViewport lets the foot rows sit at the bottom.

             Large system text makes it scroll too (2.4.0 at the TV's largest
             text size: the wordmark and count each wrapped to two lines). So
             the wordmark, the count and the foot rows stay on one line and
             shrink to the rail's width, the edges fade where the rail is cut
             instead of slicing a line in half, and MainActivity.bindRailScroll
             returns it to the top when focus leaves. -->
        <ScrollView
            android:id="@+id/rail"
            android:layout_width="@dimen/cb_nav_rail_width"
            android:layout_height="match_parent"
            android:background="@color/cb_void"
            android:fadingEdgeLength="@dimen/cb_space_lg"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/cb_rail_pad_start"
            android:paddingEnd="@dimen/cb_rail_pad_end"
            android:paddingTop="@dimen/cb_stage_top"
            android:paddingBottom="@dimen/cb_stage_bottom">

            <TextView
                android:id="@+id/kicker"
                style="@style/CoreBuilds.Eyebrow"
                android:layout_width="match_parent"
                android:paddingStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/kicker"
                android:textSize="@dimen/cb_text_rail_brand"
                app:autoSizeMaxTextSize="@dimen/cb_text_rail_brand"
                app:autoSizeMinTextSize="@dimen/cb_text_fit_min"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="12dp"
                android:fontFamily="monospace"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_count"
                app:autoSizeMaxTextSize="@dimen/cb_text_count"
                app:autoSizeMinTextSize="@dimen/cb_text_fit_min"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/apply_button"
                style="@style/Widget.CoreBuilds.Pill.Cta.Wide"
                android:layout_marginTop="@dimen/cb_space_md"
                android:nextFocusDown="@id/apply_targets"
                android:text="@string/cta_apply" />

            <TextView
                android:id="@+id/apply_sub"
                style="@style/CoreBuilds.Lede"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:paddingStart="12dp"
                android:paddingEnd="4dp" />

            <!-- ALSO APPLIES TO: heading over its chips, under the Apply it
                 belongs to. Gone as a unit with nothing to show; in icon-picker
                 mode the same band carries the banner/square shape chips.
                 focusable="false" so the hidden band can never hold the cursor;
                 afterDescendants on the list so a shown band hands focus to its
                 first chip. -->
            <LinearLayout
                android:id="@+id/apply_targets_band"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:clipChildren="false"
                android:focusable="false"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/apply_targets_label"
                    style="@style/CoreBuilds.MenuHeading"
                    android:layout_width="match_parent"
                    android:paddingStart="12dp"
                    android:text="@string/cta_also_applies" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/apply_targets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_xs"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:nextFocusUp="@id/apply_button"
                    android:nextFocusDown="@id/style_entry"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- The rows, and at the rail's foot Support | Settings | About.
                 The wrapper is what icon-picker mode hides in one go; it takes
                 the rail's leftover height so the spacer can push the foot rows
                 down to the bottom edge, and wraps them when the rail scrolls. -->
            <LinearLayout
                android:id="@+id/wallpapers_group"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/cb_space_md"
                android:clipChildren="false"
                android:orientation="vertical">

                <!-- Art style, on the home screen rather than only in Settings:
                     the switch decides what every app on the launcher looks
                     like, so it sits next to Apply. Settings' set_banner_row
                     reads the same pref. The switch is drawn, not a widget:
                     MainActivity sets it activated, and the row says the state
                     in words on its second line. -->
                <LinearLayout
                    android:id="@+id/style_entry"
                    style="@style/Widget.CoreBuilds.RailItem.Tall"
                    android:gravity="center_vertical"
                    android:nextFocusUp="@id/apply_targets"
                    android:nextFocusDown="@id/missing_entry">

                    <ImageView
                        style="@style/CoreBuilds.RailIcon"
                        android:src="@drawable/ic_nav_style" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CoreBuilds.RailTitle"
                            android:text="@string/art_style_label" />

                        <TextView
                            android:id="@+id/style_entry_sub"
                            style="@style/CoreBuilds.RailSub" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/style_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cb_space_xs"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_switch" />
                </LinearLayout>

                <!-- Missing icons: the scan is how a person gets an app added,
                     so it sits under Art style with this TV's count on it. The
                     count comes from the same AppAudit scan the screen lists,
                     run off the main thread on every resume. -->
                <LinearLayout
                    android:id="@+id/missing_entry"
                    style="@style/Widget.CoreBuilds.RailItem.Tall"
                    android:gravity="center_vertical"
                    android:nextFocusUp="@id/style_entry"
                    android:nextFocusDown="@id/wallpapers_entry">

                    <ImageView
                        style="@style/CoreBuilds.RailIcon"
                        android:src="@drawable/ic_nav_missing" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CoreBuilds.RailTitle"
                            android:text="@string/missing_entry" />

                        <TextView
                            android:id="@+id/missing_entry_sub"
                            style="@style/CoreBuilds.RailSub"
                            android:text="@string/missing_entry_scanning" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/missing_entry_count"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/cb_space_xs"
                        android:background="@drawable/bg_count_badge"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:minWidth="32dp"
                        android:paddingStart="@dimen/cb_space_xs"
                        android:paddingEnd="@dimen/cb_space_xs"
                        android:textColor="@color/cb_signal_cyan"
                        android:textSize="@dimen/cb_text_data"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wallpapers_entry"
                    style="@style/Widget.CoreBuilds.RailItem.Tall"
                    android:gravity="center_vertical"
                    android:nextFocusUp="@id/missing_entry"
                    android:nextFocusDown="@id/support_entry">

                    <ImageView
                        style="@style/CoreBuilds.RailIcon"
                        android:src="@drawable/ic_nav_wallpapers" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CoreBuilds.RailTitle"
                            android:text="@string/wp_entry" />

                        <TextView
                            android:id="@+id/wallpapers_entry_sub"
                            style="@style/CoreBuilds.RailSub" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Takes what the rail has left, so the foot rows sit at its
                     bottom edge; nothing when the rail scrolls. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="@dimen/cb_space_md" />

                <!-- Support, Settings and About: one word each, at the rail's
                     foot like a launcher's own. Support leads (2.4.0) so the
                     Ko-fi/Discord screen is one press from Home. Each label
                     stays on one line and shrinks (autoSize, never below
                     cb_text_fit_min) at the TV's largest text size;
                     MainActivity.matchRowTextSizes then gives all three the
                     smallest size so the group reads as one. -->
                <TextView
                    android:id="@+id/support_entry"
                    style="@style/Widget.CoreBuilds.RailItem"
                    android:nextFocusUp="@id/wallpapers_entry"
                    android:nextFocusDown="@id/settings_entry"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/support_label"
                    android:textSize="@dimen/cb_text_label"
                    app:autoSizeMaxTextSize="@dimen/cb_text_label"
                    app:autoSizeMinTextSize="@dimen/cb_text_fit_min"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:drawableStartCompat="@drawable/ic_nav_support" />

                <TextView
                    android:id="@+id/settings_entry"
                    style="@style/Widget.CoreBuilds.RailItem"
                    android:nextFocusUp="@id/support_entry"
                    android:nextFocusDown="@id/about_entry"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/settings_label"
                    android:textSize="@dimen/cb_text_label"
                    app:autoSizeMaxTextSize="@dimen/cb_text_label"
                    app:autoSizeMinTextSize="@dimen/cb_text_fit_min"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:drawableStartCompat="@drawable/ic_nav_settings" />

                <TextView
                    android:id="@+id/about_entry"
                    style="@style/Widget.CoreBuilds.RailItem"
                    android:nextFocusUp="@id/settings_entry"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/about_label"
                    android:textSize="@dimen/cb_text_label"
                    app:autoSizeMaxTextSize="@dimen/cb_text_label"
                    app:autoSizeMinTextSize="@dimen/cb_text_fit_min"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    app:drawableStartCompat="@drawable/ic_nav_about" />
            </LinearLayout>
        </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/cb_divider" />

        <!-- STAGE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/cb_stage_start"
            android:paddingEnd="@dimen/cb_stage_end"
            android:paddingTop="@dimen/cb_stage_top"
            android:paddingBottom="@dimen/cb_stage_bottom">

            <LinearLayout
                android:id="@+id/update_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cb_space_sm"
                android:background="@drawable/bg_section"
                android:clipChildren="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:gravity="center_vertical"
                android:nextFocusDown="@id/search"
                android:orientation="horizontal"
                android:paddingStart="@dimen/cb_space_md"
                android:paddingEnd="@dimen/cb_space_xs"
                android:paddingTop="@dimen/cb_space_xs"
                android:paddingBottom="@dimen/cb_space_xs"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/update_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_semibold"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_label" />

                    <TextView
                        android:id="@+id/update_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/update_sub_download"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_data" />

                    <!--
                        The first release highlight from version.json, one line,
                        ellipsised. Gone unless the manifest carries highlights,
                        and mutually exclusive with update_sub: MainActivity shows
                        one or the other, never both.

                        That is a height rule, not a styling one. This bar is
                        fixed chrome above a grid that is the weighted remainder
                        of 540dp, and the full bullet list (version.json carries
                        eight) is ~160dp on its own - shown in full it pushed the
                        grid to zero height, which is the "lists disappeared"
                        symptom with a network callback as the trigger. One line
                        keeps the bar short, and the whole list is on the release
                        page the Download button is fetching from.
                    -->
                    <TextView
                        android:id="@+id/update_highlights"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_data"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/update_button"
                    style="@style/Widget.CoreBuilds.Pill.Cta"
                    android:layout_height="@dimen/cb_pill_compact"
                    android:layout_marginStart="@dimen/cb_space_md"
                    android:nextFocusDown="@id/search"
                    android:nextFocusRight="@id/update_later"
                    android:text="@string/update_download" />

                <!-- Dismiss for this session: the bar's height comes out of the
                     grid, and this is the press that gives it back. -->
                <TextView
                    android:id="@+id/update_later"
                    style="@style/Widget.CoreBuilds.Pill.Ghost"
                    android:layout_height="@dimen/cb_pill_compact"
                    android:layout_marginStart="@dimen/cb_space_xs"
                    android:nextFocusDown="@id/search"
                    android:nextFocusLeft="@id/update_button"
                    android:text="@string/update_later" />
            </LinearLayout>

            <TextView
                android:id="@+id/picker_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/cb_space_sm"
                android:text="@string/picker_hint"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_label"
                android:visibility="gone" />

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/cb_target_min"
                android:background="@drawable/bg_search"
                android:drawablePadding="@dimen/cb_space_sm"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusDown="@id/chip_row"
                android:paddingStart="@dimen/cb_pill_padding"
                android:paddingEnd="@dimen/cb_pill_padding"
                android:paddingTop="@dimen/cb_space_sm"
                android:paddingBottom="@dimen/cb_space_sm"
                android:textColor="@color/cb_ink"
                android:textColorHint="@color/cb_slate"
                android:textSize="@dimen/cb_text_label"
                app:drawableStartCompat="@drawable/ic_search"
                app:drawableTint="@color/cb_slate" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chip_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nextFocusUp="@id/search"
                android:nextFocusDown="@id/grid"
                android:orientation="horizontal" />

            <!-- No-results state. Without this a filter with no match renders an
                 empty grid and gives the user nothing to undo. -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/cb_space_xl"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/empty_title"
                    style="@style/CoreBuilds.Section" />

                <TextView
                    android:id="@+id/empty_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_xs"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="560dp"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_label" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_md"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/empty_clear_search"
                        style="@style/Widget.CoreBuilds.Pill.Cta"
                        android:layout_marginEnd="@dimen/cb_space_sm"
                        android:text="@string/empty_clear_search" />

                    <TextView
                        android:id="@+id/empty_clear_filter"
                        style="@style/Widget.CoreBuilds.Pill.Ghost"
                        android:text="@string/empty_clear_filter" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:nextFocusUp="@id/chip_row" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
