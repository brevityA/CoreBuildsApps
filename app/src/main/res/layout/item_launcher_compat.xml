<?xml version="1.0" encoding="utf-8"?>
<!--
  One launcher in the compatibility list: its name, whether this TV is on it
  (active/installed), what art it applies, how the pack reaches it, and the
  first of its notes. Not focusable - a compatibility row is read, not
  pressed; the RecyclerView owns the D-pad.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/cb_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/launcher_compat_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/launcher_compat_item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cb_space_sm"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_kicker"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/launcher_compat_item_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cb_space_md"
            android:fontFamily="monospace"
            android:letterSpacing="0.18"
            android:textColor="@color/cb_signal_cyan"
            android:textSize="@dimen/cb_text_kicker"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/launcher_compat_item_art"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />

    <TextView
        android:id="@+id/launcher_compat_item_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data"
        android:visibility="gone" />
</LinearLayout>
