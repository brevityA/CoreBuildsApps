<?xml version="1.0" encoding="utf-8"?>
<!-- Export progress + result. Centered card on night chrome so it reads as a
     modal step rather than another browser (Brand Guide §05). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_night"
    android:padding="@dimen/cb_gutter_side">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/cb_space_xl"
        android:background="@drawable/bg_row">

        <TextView
            android:id="@+id/export_title"
            style="@style/CoreBuilds.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/export_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cb_space_xs"
            android:fontFamily="monospace"
            android:textColor="@color/cb_signal_cyan"
            android:textSize="@dimen/cb_text_body" />

        <ProgressBar
            android:id="@+id/export_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:indeterminateTint="@color/cb_signal_cyan"
            android:max="100"
            android:progressTint="@color/cb_signal_cyan" />

        <TextView
            android:id="@+id/export_after_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/wp_after_export_hint"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_body"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/export_launchers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cb_space_md"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/export_cancel"
                style="@style/Widget.CoreBuilds.Pill.Ghost"
                android:layout_width="wrap_content"
                android:layout_marginEnd="@dimen/cb_space_sm"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/wp_cancel"
                android:layout_height="@dimen/cb_pill" />

            <TextView
                android:id="@+id/export_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/cb_space_sm"
                android:background="@drawable/bg_chip_toggle"
                android:minHeight="@dimen/cb_target_min"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingStart="@dimen/cb_space_lg"
                android:paddingTop="@dimen/cb_space_sm"
                android:paddingEnd="@dimen/cb_space_lg"
                android:paddingBottom="@dimen/cb_space_sm"
                android:text="@string/wp_retry_failed"
                android:textColor="@color/cb_warning"
                android:textSize="@dimen/cb_text_body"
                android:visibility="gone"
                android:fontFamily="@font/outfit_semibold" />

            <TextView
                android:id="@+id/export_done"
                style="@style/Widget.CoreBuilds.Pill.Cta"
                android:layout_width="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/wp_done"
                android:visibility="gone"
                android:layout_height="@dimen/cb_pill" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
