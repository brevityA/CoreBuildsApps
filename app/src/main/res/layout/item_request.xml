<?xml version="1.0" encoding="utf-8"?>
<!-- One My requests row: the app and its component on the left, the
     issue's state and number on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_card"
    android:baselineAligned="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/cb_card_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/request_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/request_component"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_kicker" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cb_space_md"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/request_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/cb_text_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/request_issue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_kicker" />
    </LinearLayout>
</LinearLayout>
