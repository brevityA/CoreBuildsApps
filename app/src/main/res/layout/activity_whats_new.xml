<?xml version="1.0" encoding="utf-8"?>
<!--
  What's new. The post-update counterpart of the update bar: the bar says
  one line before a build installs, this screen reads the whole highlights
  list of the build that just did, off the APK's own assets/version.json.

  Same grammar as Settings: one focusable row (Done), a ScrollView for the
  content so a long release list or a raised font scale scrolls instead of
  clipping (see test_tv_layout_fit.py), header pinned outside the scroll.
  The bullet rows are runtime content — What's New is only interesting when
  it says THIS build's changes — so the list is a container the activity
  fills from the manifest, not a stack of hand-written TextViews.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_night"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <TextView
        style="@style/CoreBuilds.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/whats_new_kicker" />

    <TextView
        android:id="@+id/whats_new_title"
        style="@style/CoreBuilds.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/whats_new_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_xs"
        android:visibility="gone"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/cb_space_md">

        <LinearLayout
            android:id="@+id/whats_new_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Done: the screen's one action, a pill (2.6.0). A LinearLayout around
         its label because WhatsNewActivity finds it as one. -->
    <LinearLayout
        android:id="@+id/whats_new_done"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/cb_pill"
        android:layout_marginTop="@dimen/cb_space_md"
        android:background="@drawable/bg_pill_cta"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:minWidth="@dimen/cb_button_min_width"
        android:paddingStart="@dimen/cb_pill_padding"
        android:paddingEnd="@dimen/cb_pill_padding"
        android:stateListAnimator="@animator/focus_lift">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:fontFamily="@font/outfit_bold"
            android:text="@string/whats_new_done"
            android:textColor="@color/cta_text"
            android:textSize="@dimen/cb_text_button" />
    </LinearLayout>
</LinearLayout>
