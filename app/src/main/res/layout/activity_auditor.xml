<?xml version="1.0" encoding="utf-8"?>
<!--
  The unmapped-apps auditor. Two states in one screen: the scrollable list of
  launchable apps appfilter never names, and the QR panel for the picked one.
  Back leaves the panel before it leaves the screen (AuditorActivity owns that
  grammar), so the panel holds nothing focusable - the code is output, not a
  control - and the header back button is the one D-pad stop in that state.

  Chrome grammar copied from Settings: pinned header, one ScrollView-or-list
  between header and bottom edge, scrollbar visible so overflow is legible.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audit_kicker" />

            <TextView
                style="@style/CoreBuilds.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/audit_title" />
        </LinearLayout>

        <!-- Request all (Core Builds Plus, Google Play only): gone until
             AuditorActivity.showRequestAll finds Plus on sale or owned, a
             broker baked in and an unrequested missing app. -->
        <TextView
            android:id="@+id/audit_request_all"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_width="wrap_content"
            android:layout_marginEnd="@dimen/cb_space_sm"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:layout_height="@dimen/cb_pill" />

        <TextView
            android:id="@+id/audit_back"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_width="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/action_back"
            android:layout_height="@dimen/cb_pill_compact"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            app:drawableStartCompat="@drawable/ic_chevron_start"
            app:drawableTint="@color/pill_ghost_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/audit_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_xs"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />

    <!-- Which launcher this TV is on, detected: half of "icon not applying"
         is the launcher, not the mapping (phone launchers take the glyphs,
         Fire TV builds ship different activities, a launcher without inbound
         apply needs the walk). The line opens the compatibility screen.
         Focusable, because a TV line that says something and cannot be
         reached by the D-pad is a label, not a stop. -->
    <TextView
        android:id="@+id/audit_launcher_note"
        style="@style/Widget.CoreBuilds.Pill.Ghost.Wide"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/cb_space_sm"
        android:clickable="true"
        android:contentDescription="@string/launcher_compat_note_cd"
        android:focusable="true"
        android:layout_height="@dimen/cb_pill" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/audit_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/cb_space_sm"
        android:paddingBottom="@dimen/cb_space_xs"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/audit_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_body"
        android:visibility="gone" />

    <!-- QR panel: output, not controls. Nothing inside is focusable. Two
         columns, because a TV is wide and short: the request's identity and
         the instructions on the left, the code on the right at a size a
         phone camera reads from the sofa. Stacked, the code plus the text
         under it ran past the bottom of a 540dp panel. -->
    <LinearLayout
        android:id="@+id/audit_qr_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/cb_space_md"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/cb_space_lg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/audit_qr_kind"
                style="@style/CoreBuilds.Eyebrow" />

            <!-- The request's identity, in plain sight and photographable:
                 current launcher icon next to the app name and component.
                 Even if every prefill parameter were lost downstream, a photo
                 of this panel still carries everything a triage needs. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/cb_card_padding"
                android:background="@drawable/bg_row">

                <ImageView
                    android:id="@+id/audit_qr_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/audit_qr_icon_hint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/cb_space_sm"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/audit_qr_app_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_section"
                        android:fontFamily="@font/outfit_semibold" />

                    <TextView
                        android:id="@+id/audit_qr_component"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_data" />

                    <TextView
                        android:id="@+id/audit_qr_mapped"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:textColor="@color/cb_warning"
                        android:textSize="@dimen/cb_text_data"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:lineSpacingExtra="3dp"
                android:text="@string/audit_qr_hint"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data" />

            <TextView
                android:id="@+id/audit_qr_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker" />
        </LinearLayout>

        <!-- White quiet zone comes from the bitmap itself (QrBitmap). -->
        <ImageView
            android:id="@+id/audit_qr_view"
            android:layout_width="@dimen/cb_qr_size"
            android:layout_height="@dimen/cb_qr_size"
            android:contentDescription="@string/audit_qr_hint"
            android:focusable="false"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
