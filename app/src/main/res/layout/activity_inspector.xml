<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon inspector. One card: the bundled mark at full size beside what the
  pack knows about it (category, drawable, every mapped component), and the
  two actions - export, launch - as the only focus stops after the header
  back. Nothing else on the screen is focusable; the data is output.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspector_kicker" />

            <TextView
                android:id="@+id/inspector_title"
                style="@style/CoreBuilds.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/inspector_back"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_width="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/action_back"
            android:layout_height="@dimen/cb_pill_compact"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            app:drawableStartCompat="@drawable/ic_chevron_start"
            app:drawableTint="@color/pill_ghost_text" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/cb_space_md"
            android:paddingBottom="@dimen/cb_space_xs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/cb_card_padding"
                android:background="@drawable/bg_row">

                <ImageView
                    android:id="@+id/inspector_icon"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:focusable="false" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/cb_space_md"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/inspector_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_data" />

                    <TextView
                        android:id="@+id/inspector_components"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cb_space_sm"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_data" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:orientation="horizontal"
                android:gravity="end">

                <TextView
                    android:id="@+id/inspector_export"
                    style="@style/Widget.CoreBuilds.Pill.Ghost"
                    android:layout_width="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/inspector_export"
                    android:layout_height="@dimen/cb_pill" />

                <TextView
                    android:id="@+id/inspector_launch"
                    style="@style/Widget.CoreBuilds.Pill.Cta"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/cb_space_md"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/inspector_launch"
                    android:layout_height="@dimen/cb_pill" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
