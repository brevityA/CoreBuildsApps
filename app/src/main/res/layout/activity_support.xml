<?xml version="1.0" encoding="utf-8"?>
<!--
  Support (2.6.0, the stage grammar). Opened from Home, Settings and About.
  What it is on the left, the way to act on it on the right, side by side
  because a TV is wide and short.

  GitHub builds: two codes a phone reads. Nothing in them takes focus: a QR
  code is something a phone reads, not a control a remote presses, so Back is
  the screen's one stop there.

  The Google Play build is Core Premium (Plus in code) instead of the codes
  (Play's Payments policy keeps a Play app's payments inside Play Billing): the
  six extras as a list on the left, the purchase card on the right. The list
  is a stop so a remote can scroll it at large text sizes. The buy button is
  a stop only while Premium is on sale, and the trial button only until the
  trial is used: SupportActivity moves the cursor to Back before either stops
  being focusable.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Eyebrow"
                android:text="@string/support_kicker" />

            <TextView
                style="@style/CoreBuilds.Title"
                android:text="@string/support_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/support_back"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_height="@dimen/cb_pill_compact"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            android:text="@string/action_back"
            app:drawableStartCompat="@drawable/ic_chevron_start"
            app:drawableTint="@color/pill_ghost_text" />
    </LinearLayout>

    <!-- BODY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/cb_space_md"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- LEFT: what this is and what it is not. A ScrollView, as About's
             facts column is: at the TV's largest text the six extras run past
             the panel, and the list is focusable so a remote can reach it -
             DOWN on a list taller than the column scrolls it before focus
             moves on. When everything fits the ScrollView is inert. -->
        <ScrollView
            android:id="@+id/support_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/cb_space_lg"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/support_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/support_body"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label" />

            <!-- Core Premium's six extras (Google Play build). One row each:
                 icon, name, the line that says what it does. Focusable, with
                 the ring, so the column above can scroll to its last row. -->
            <LinearLayout
                android:id="@+id/support_features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:background="@drawable/bg_row"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:stateListAnimator="@animator/focus_raise"
                android:orientation="vertical"
                android:paddingStart="@dimen/cb_space_md"
                android:paddingEnd="@dimen/cb_space_md"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <include layout="@layout/item_plus_feature"
                    android:id="@+id/plus_feature_priority" />
                <include layout="@layout/item_plus_feature"
                    android:id="@+id/plus_feature_tracker" />
                <include layout="@layout/item_plus_feature"
                    android:id="@+id/plus_feature_rotation" />
                <include layout="@layout/item_plus_feature"
                    android:id="@+id/plus_feature_night" />
                <include layout="@layout/item_plus_feature"
                    android:id="@+id/plus_feature_projectivy" />
                <include layout="@layout/item_plus_feature"
                    android:id="@+id/plus_feature_walls" />
            </LinearLayout>

            <!-- What is optional. Under the list on GitHub builds; on Google
                 Play the list fills this column, so the line moves under the
                 card (support_mode_card) and this one goes. -->
            <TextView
                android:id="@+id/support_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:lineSpacingExtra="3dp"
                android:text="@string/support_mode"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />
        </LinearLayout>
        </ScrollView>

        <!-- RIGHT: the way to act on it, and the line that says what it sends. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- GitHub builds: the two codes. White quiet zones come from the
             bitmaps (QrBitmap), so the dark section behind them cannot eat one. -->
        <LinearLayout
            android:id="@+id/support_codes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section"
            android:orientation="vertical"
            android:padding="@dimen/cb_card_padding">

            <ImageView
                android:id="@+id/support_sponsors_qr"
                android:layout_width="@dimen/cb_support_qr"
                android:layout_height="@dimen/cb_support_qr"
                android:contentDescription="@string/support_sponsors_qr_hint"
                android:focusable="false"
                android:scaleType="fitCenter" />

            <TextView
                style="@style/CoreBuilds.Section"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:text="@string/support_sponsors_label" />

            <TextView
                android:id="@+id/support_sponsors_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cb_space_md"
            android:background="@drawable/bg_section"
            android:orientation="vertical"
            android:padding="@dimen/cb_card_padding">

            <ImageView
                android:id="@+id/support_kofi_qr"
                android:layout_width="@dimen/cb_support_qr"
                android:layout_height="@dimen/cb_support_qr"
                android:contentDescription="@string/support_kofi_qr_hint"
                android:focusable="false"
                android:scaleType="fitCenter" />

            <TextView
                style="@style/CoreBuilds.Section"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:text="@string/support_kofi_label" />

            <TextView
                android:id="@+id/support_kofi_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker" />
        </LinearLayout>
        </LinearLayout>

        <!-- Google Play build: the Core Premium card (Plus in code). The status
             line says where the purchase and the trial stand; the first button
             buys, the second starts the one 24-hour trial. -->
        <LinearLayout
            android:id="@+id/support_plus"
            android:layout_width="@dimen/cb_support_plus_card"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section"
            android:clipChildren="false"
            android:orientation="vertical"
            android:padding="@dimen/cb_space_md"
            android:visibility="gone">

            <TextView
                style="@style/CoreBuilds.Section"
                android:text="@string/plus_name" />

            <TextView
                android:id="@+id/support_plus_status"
                style="@style/CoreBuilds.Lede"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:text="@string/plus_loading" />

            <TextView
                android:id="@+id/support_plus_buy"
                style="@style/Widget.CoreBuilds.Pill.Cta.Wide"
                android:layout_marginTop="@dimen/cb_space_md"
                android:clickable="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:text="@string/plus_loading_button" />

            <TextView
                android:id="@+id/support_plus_trial"
                style="@style/Widget.CoreBuilds.Pill.Ghost.Wide"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:text="@string/plus_trial_button"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/support_mode_card"
            android:layout_width="@dimen/cb_support_plus_card"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cb_space_md"
            android:lineSpacingExtra="3dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/support_mode"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_data"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cb_space_sm"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:maxWidth="@dimen/cb_support_plus_card"
            android:text="@string/support_footer"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_kicker" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
