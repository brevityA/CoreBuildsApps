<?xml version="1.0" encoding="utf-8"?>
<!--
  About -> Send feedback (Google Play build). The feedback form as a QR for a
  phone, beside what it does and, for a phone with no camera, the form's
  short address and the two lines the QR would have filled in. Same chrome grammar as FAQ: pinned header with the back button.
  Nothing in the body is focusable: there is nothing to press but Back.
  The QR is drawn on a light card (bg_section), as Support's codes are, so the
  dark night behind it cannot eat a module.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_kicker" />

            <TextView
                style="@style/CoreBuilds.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/feedback_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/feedback_back"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_width="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/action_back"
            android:layout_height="@dimen/cb_pill_compact"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            app:drawableStartCompat="@drawable/ic_chevron_start"
            app:drawableTint="@color/pill_ghost_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_md"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section"
            android:orientation="vertical"
            android:padding="@dimen/cb_card_padding">

            <ImageView
                android:id="@+id/feedback_qr"
                android:layout_width="@dimen/cb_support_qr"
                android:layout_height="@dimen/cb_support_qr"
                android:contentDescription="@string/feedback_qr_cd"
                android:focusable="false"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cb_space_md"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Section"
                android:text="@string/feedback_scan" />

            <TextView
                style="@style/CoreBuilds.Lede"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:text="@string/feedback_lede" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:text="@string/feedback_type_it"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />

            <!-- The form's short address, whole at any text size; the QR
                 carries the prefilled one. -->
            <TextView
                android:id="@+id/feedback_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker" />

            <!-- What the QR would have filled in, to type into the form. -->
            <TextView
                android:id="@+id/feedback_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
