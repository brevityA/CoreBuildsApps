<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen wallpaper preview. The image fills the canvas; the title and
     CTA float over a bottom scrim so the cyan-on-night glass stays legible
     against any of the 30 wallpapers (Brand Guide §05). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_void">

    <ImageView
        android:id="@+id/preview_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/preview_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/cb_ink"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/preview_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/cb_glow_cyan"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/preview_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_ghost"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/preview_set"
            android:paddingStart="22dp"
            android:paddingTop="13dp"
            android:paddingEnd="22dp"
            android:paddingBottom="13dp"
            android:text="@string/wp_back"
            android:textColor="@color/cb_slate"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cta"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/preview_back"
            android:paddingStart="28dp"
            android:paddingTop="13dp"
            android:paddingEnd="28dp"
            android:paddingBottom="13dp"
            android:text="@string/wp_set_wallpaper"
            android:textColor="@color/cb_cta_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
