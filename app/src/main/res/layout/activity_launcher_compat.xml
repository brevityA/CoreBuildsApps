<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher compatibility: one row per known launcher - what art it applies
  (16:9 banners from the appfilter, or the square glyphs from Core Builds
  Glyphs), how the pack reaches it (auto-apply, the launcher's own settings,
  per-app, not at all), and the launcher-specific notes. The data is
  ApplyIconPack's; this screen only displays it, so it cannot drift from what
  the apply flow would have done with the same launcher.

  Chrome grammar copied from Settings: pinned header, one list between header
  and bottom edge, scrollbar visible so overflow is legible. Rows are NOT
  focusable - the same read-only grammar as the FAQ cards: a focusable
  paragraph is a D-pad trap, and a compatibility row has nothing to press.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/CoreBuilds.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/launcher_compat_kicker" />

            <TextView
                style="@style/CoreBuilds.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/launcher_compat_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/launcher_compat_back"
            style="@style/Widget.CoreBuilds.Pill.Ghost"
            android:layout_width="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/action_back"
            android:layout_height="@dimen/cb_pill_compact"
            android:drawablePadding="6dp"
            android:paddingStart="12dp"
            app:drawableStartCompat="@drawable/ic_chevron_start"
            app:drawableTint="@color/pill_ghost_text" />
    </LinearLayout>

    <!-- This TV's launcher, detected: the one row the user is actually on.
         The unknown case says so plainly instead of guessing. -->
    <TextView
        android:id="@+id/launcher_compat_here"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_xs"
        android:textColor="@color/cb_signal_cyan"
        android:textSize="@dimen/cb_text_data"
        android:visibility="gone" />

    <TextView
        android:id="@+id/launcher_compat_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/launcher_compat_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/cb_space_sm"
        android:paddingBottom="@dimen/cb_space_xs"
        android:scrollbars="vertical" />
</LinearLayout>
