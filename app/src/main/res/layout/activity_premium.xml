<?xml version="1.0" encoding="utf-8"?>
<!--
  Core Builds Premium: what the one-off purchase unlocks, and the button that
  buys it. Reached only from the Play build — the GitHub/Downloader build has
  every series and every loop already, so nothing there links here.

  Two zones: what you get on the left, the purchase on the right, because a TV
  is wide and short. The body takes no focus; the screen's stops are the
  purchase button, the restore button and Back, in that order.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_night"
    android:orientation="vertical"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:paddingStart="@dimen/cb_space_sm"
                android:paddingEnd="@dimen/cb_space_sm"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="@string/premium_kicker"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_kicker"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:letterSpacing="-0.025"
                android:text="@string/premium_title"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_title"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/premium_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/cb_target_min"
            android:minWidth="@dimen/cb_button_min_width"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingEnd="@dimen/cb_space_lg"
            android:text="@string/action_back"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_body" />
    </LinearLayout>

    <!-- BODY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cb_space_lg"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- WHAT IT UNLOCKS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/cb_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:text="@string/premium_included_header"
                android:textColor="@color/cb_success"
                android:textSize="@dimen/cb_text_kicker"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/premium_included"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:text="@string/premium_included_body"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label" />

            <TextView
                android:id="@+id/premium_free_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:text="@string/premium_free_note"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />
        </LinearLayout>

        <!-- THE PURCHASE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/cb_space_lg"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/cb_card_padding">

            <TextView
                android:id="@+id/premium_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/premium_state_connecting"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/premium_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:text="@string/premium_price_unknown"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_label" />

            <!-- One purchase, no subscription: the button says so. -->
            <TextView
                android:id="@+id/premium_buy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:background="@drawable/bg_cta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/cb_target_min"
                android:paddingStart="@dimen/cb_space_lg"
                android:paddingEnd="@dimen/cb_space_lg"
                android:text="@string/premium_buy"
                android:textColor="@color/cb_cta_ink"
                android:textSize="@dimen/cb_text_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/premium_restore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:background="@drawable/bg_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/cb_target_min"
                android:paddingStart="@dimen/cb_space_lg"
                android:paddingEnd="@dimen/cb_space_lg"
                android:text="@string/premium_restore"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label" />

            <!-- Google's rule, stated where the purchase happens: card details
                 never reach this app, and a Play TV box without Play cannot
                 buy at all - that has to be said in words, not shown as a
                 spinner that never stops. -->
            <TextView
                android:id="@+id/premium_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:text="@string/premium_note"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
