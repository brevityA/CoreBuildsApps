<?xml version="1.0" encoding="utf-8"?>
<!--
  Core Builds UI metrics, Brand Guide v1.0 §05.

  One place to tune density and screen size, instead of literals repeated
  across every layout.

  Scale is 8dp-based. Every focusable control reaches the 48dp Material
  minimum through padding rather than minHeight, so the visual chip stays
  slim while the hit area is real.
-->
<resources>

    <!-- Screen gutters. Side padding is inset-aware (see activity_main). -->
    <dimen name="cb_gutter_side">48dp</dimen>
    <dimen name="cb_gutter_top">40dp</dimen>
    <dimen name="cb_gutter_bottom">24dp</dimen>
    <!-- Narrow fallback for 720p / legacy panels that overscan. -->
    <dimen name="cb_gutter_side_narrow">32dp</dimen>
    <!-- Tighter top/bottom gutters for the one screen whose chrome competes
         with its grid for the 540dp a 1080p panel reports: the catalogue. Every
         other screen scrolls, so it keeps the house gutters above. -->
    <dimen name="cb_gutter_top_tight">24dp</dimen>
    <dimen name="cb_gutter_bottom_tight">12dp</dimen>
    <!-- The home and wallpapers screens are two-pane on a TV: this rail holds
         the sheet's vertical stack (wordmark, CTA, entry rows, ALSO APPLIES TO,
         and on wallpapers the series chips and the export foot) while the grid
         takes the rest of the panel. Fixed width, so the pane - and therefore
         the tile columns - is derived, not guessed. Measured in the normalised
         dp box, so it is the same rail on every panel. -->
    <dimen name="cb_rail_width">300dp</dimen>

    <!-- Spacing rhythm. -->
    <dimen name="cb_space_xs">8dp</dimen>
    <dimen name="cb_space_sm">12dp</dimen>
    <dimen name="cb_space_md">16dp</dimen>
    <dimen name="cb_space_lg">26dp</dimen>
    <dimen name="cb_space_xl">30dp</dimen>

    <!-- Grid. The gap is delivered by the card focus inset, so tiles never
         touch even though RecyclerView adds no ItemDecoration. -->
    <dimen name="cb_card_padding">14dp</dimen>
    <dimen name="cb_card_icon">76dp</dimen>
    <!-- Brandmark dot on an icon tile. 7dp reads at 3m without
         crowding artwork that already runs to the tile edge. -->
    <dimen name="cb_brandmark_dot">7dp</dimen>
    <dimen name="cb_wp_thumb">118dp</dimen>
    <!-- Catalogue tile glyph. The design sheet's tiles are glyph-only squares:
         the name lives in the inspector and in the tile's content description,
         not under the art. The two-pane home screen gives the grid the whole
         right-hand pane, so the glyph can be the sheet's size again; the grid's
         column count is derived from this dimen and the pane width, which is
         what keeps the tiles square-proportioned on a 4K panel that reports a
         larger dp box (see values-sw720dp). -->
    <dimen name="cb_tile_icon">128dp</dimen>
    <dimen name="cb_seed_swatch">32dp</dimen>

    <!-- Radii. Chip is a pill. -->
    <dimen name="cb_radius_card">14dp</dimen>
    <dimen name="cb_radius_button">10dp</dimen>
    <dimen name="cb_radius_field">10dp</dimen>
    <dimen name="cb_radius_pill">999dp</dimen>
    <!-- Card radius minus cb_focus_inset, so the inner fill stays concentric
         with the ring instead of looking pinched at the corners. -->
    <dimen name="cb_radius_card_inner">8dp</dimen>
    <!-- Card radius minus cb_focus_ring, for the gap layer between ring and
         card in bg_card. Keeps the three concentric shapes aligned. -->
    <dimen name="cb_radius_card_gap">11dp</dimen>

    <!-- Focus: a 3dp ring, a 3dp gap of background, then the card. The gap
         keeps focus and the filled selected-chip state unmistakable at 3m. -->
    <dimen name="cb_focus_ring">3dp</dimen>
    <dimen name="cb_focus_gap">3dp</dimen>
    <dimen name="cb_focus_inset">6dp</dimen>

    <!-- Minimum touch / D-pad target. Material floor. -->
    <dimen name="cb_target_min">48dp</dimen>
    <!-- The auditor's request code: about a third of a 1080p panel's height,
         which a phone camera reads across a living room. -->
    <dimen name="cb_qr_size">320dp</dimen>
    <!-- Support shows two codes side by side, so each is smaller. Its URLs
         encode at 29 modules, about 6dp a module here. -->
    <dimen name="cb_support_qr">220dp</dimen>
    <!-- The Plus card (Google Play build): wide enough for two lines of status. -->
    <dimen name="cb_support_plus_width">380dp</dimen>

    <!-- Stacked action buttons share a minimum width so they align as a column
         instead of jagging to their text length. -->
    <dimen name="cb_button_min_width">220dp</dimen>

    <!-- Type scale. 12sp is the floor — nothing in the app renders smaller,
         because a TV is read at ~3m, not at arm's length. -->
    <dimen name="cb_text_kicker">12sp</dimen>
    <!-- TV labels need to remain readable at a 10-foot viewing distance. -->
    <dimen name="cb_text_data">14sp</dimen>
    <dimen name="cb_text_label">16sp</dimen>
    <dimen name="cb_text_body">17sp</dimen>
    <dimen name="cb_text_section">19sp</dimen>
    <dimen name="cb_text_title">32sp</dimen>
    <dimen name="cb_text_display">34sp</dimen>
    <!-- The smallest a one-line label may shrink to when the system text size
         makes it wider than its slot (the home rail's wordmark, count and
         Support | Settings | About). The floor above, not below it: being sp, it
         grows with the user's setting too, so large text still reads larger. -->
    <dimen name="cb_text_fit_min">12sp</dimen>

    <!-- Rail and stage (2.6.0), ported from Core EQ 1.12. The rail is the
         full-height void column on Home and Wallpapers; the stage is the rest
         of the 960dp box. The rail's start padding keeps its labels 40dp in
         from the panel edge (28 + a row's 12), inside an overscanning set's
         crop, where Core EQ's sit at 22dp. -->
    <dimen name="cb_nav_rail_width">264dp</dimen>
    <dimen name="cb_rail_pad_start">28dp</dimen>
    <!-- The rail's wordmark and count. Both shrink to fit at large system text
         (autoSize), so both start above the 12sp floor: AppCompat refuses an
         autoSize range whose top is its bottom, and the screen would not
         inflate. 264dp leaves the count's 28 monospace characters room at 12sp. -->
    <dimen name="cb_text_rail_brand">14sp</dimen>
    <dimen name="cb_text_count">13sp</dimen>
    <dimen name="cb_rail_pad_end">16dp</dimen>
    <dimen name="cb_rail_item">40dp</dimen>
    <!-- A rail row with a second line under its name (Art style, Missing
         icons, Wallpapers): the line carries a count or a state. -->
    <dimen name="cb_rail_item_tall">56dp</dimen>
    <dimen name="cb_rail_icon">20dp</dimen>
    <dimen name="cb_stage_start">28dp</dimen>
    <dimen name="cb_stage_end">44dp</dimen>
    <dimen name="cb_stage_top">28dp</dimen>
    <dimen name="cb_stage_bottom">20dp</dimen>
    <!-- Icon tiles stay three across on the wider stage: a column never goes
         narrower than this, so a banner keeps a 16:9 card ~180dp wide. -->
    <dimen name="cb_tile_min_width">192dp</dimen>
    <!-- Pills: the standard control is 48dp, the dense one 40dp. -->
    <dimen name="cb_pill">48dp</dimen>
    <dimen name="cb_pill_compact">40dp</dimen>
    <dimen name="cb_pill_padding">18dp</dimen>
    <dimen name="cb_radius_section">16dp</dimen>
    <dimen name="cb_radius_rail_item">12dp</dimen>
    <!-- How far a focused control rises (its shadow is tinted cyan on API 28+). -->
    <dimen name="cb_lift_z">6dp</dimen>
    <dimen name="cb_text_button">15sp</dimen>
    <dimen name="cb_text_stage_title">28sp</dimen>
    <!-- Core Premium's feature list: one row per extra, icon then two lines. -->
    <dimen name="cb_feature_icon">22dp</dimen>
    <dimen name="cb_support_plus_card">340dp</dimen>

</resources>
