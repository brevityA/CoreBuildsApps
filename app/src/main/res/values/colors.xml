<?xml version="1.0" encoding="utf-8"?>
<!-- Core Builds palette, Brand Guide v1.0 §03. Do not add accents without a meaning slot. -->
<resources>
    <color name="cb_core_cyan">#00E5FF</color>
    <color name="cb_signal_cyan">#00D4FF</color>
    <color name="cb_glow_cyan">#7EEEFF</color>
    <color name="cb_build_blue">#4FACFE</color>
    <color name="cb_dusk_violet">#8A4890</color>
    <color name="cb_ember">#C03A20</color>
    <color name="cb_night">#0D1117</color>
    <color name="cb_panel">#1A2030</color>
    <color name="cb_card">#151923</color>
    <color name="cb_void">#04070F</color>
    <color name="cb_slate">#8B949E</color>
    <color name="cb_ink">#E6EDF3</color>
    <color name="cb_cta_start">#00ABD3</color>
    <color name="cb_cta_end">#00D4FF</color>
    <color name="cb_cta_ink">#04202B</color>
    <color name="cb_success">#34D399</color>
    <color name="cb_warning">#FBBF24</color>

    <!-- UI-role colours, not brand accents. Each has exactly one meaning slot,
         per the §03 rule above: these describe interaction state, so they may
         not be reused for identity or artwork. -->

    <!-- Focus halo behind the 3dp ring. Sits outside the gap so focus reads
         at 3m without the ring itself needing to grow. -->
    <color name="cb_focus_glow">#3300D4FF</color>
    <!-- Press feedback. Feeds colorControlHighlight so the ripple is brand
         cyan instead of the platform grey. -->
    <color name="cb_ripple">#2E00D4FF</color>
    <!-- Resting border on cards and fields: 1dp at 6% white. -->
    <color name="cb_hairline">#0FFFFFFF</color>

    <!-- Rail and stage (2.6.0), the roles Core EQ 1.12 introduced, at Core EQ's
         values so the two apps draw one control the same way. Interaction
         state and structure only, like the three above. -->
    <!-- The resting body of a pill, a section and a rail row's panel. -->
    <color name="cb_card_surface">#161B22</color>
    <!-- An off switch's track. -->
    <color name="cb_card_focus">#30363D</color>
    <!-- The 3dp focus ring (Brand Guide §05): signal cyan, named for its role. -->
    <color name="cb_focus_ring">#00D4FF</color>
    <!-- Lines between regions: the rail's edge, a section's border. White at 8%. -->
    <color name="cb_divider">#14FFFFFF</color>
    <!-- A chosen row, segment or filter: cyan at 16% with a 60% cyan edge. -->
    <color name="cb_selected_fill">#2900D4FF</color>
    <color name="cb_selected_edge">#9900D4FF</color>
    <!-- A secondary pill's resting edge: cyan at 35%. -->
    <color name="cb_ghost_edge">#5900D4FF</color>
    <!-- Text on a control that cannot be pressed. -->
    <color name="cb_text_disabled">#668B949E</color>
</resources>
