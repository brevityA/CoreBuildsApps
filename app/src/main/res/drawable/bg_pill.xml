<?xml version="1.0" encoding="utf-8"?>
<!--
  The standard control (1.12.0): a pill. At rest a card-coloured body with a
  hairline; focused, a panel body inside the 3dp Brand Guide §05 ring; chosen
  or on (activated), cyan at 16% with a cyan edge, and the ring over it when
  focused too. Disabled keeps only the hairline.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_selected_fill" />
            <stroke android:width="@dimen/cb_focus_ring" android:color="@color/cb_focus_ring" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <stroke android:width="@dimen/cb_focus_ring" android:color="@color/cb_focus_ring" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/cb_hairline" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_selected_fill" />
            <stroke android:width="1dp" android:color="@color/cb_selected_edge" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_card_surface" />
            <stroke android:width="1dp" android:color="@color/cb_divider" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
</selector>
