<?xml version="1.0" encoding="utf-8"?>
<!-- Ghost / secondary button (Brand Guide §05): #101923, hairline border.
     Focused state lifts to panel with the cyan signal ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <corners android:radius="11dp" />
            <stroke android:width="2dp" android:color="@color/cb_signal_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#101923" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="#1CFFFFFF" />
        </shape>
    </item>
</selector>
