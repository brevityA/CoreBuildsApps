<?xml version="1.0" encoding="utf-8"?>
<!-- Search field: 8dp radius, subtler fill. Focus lifts with warm glow ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1400D4FF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cb_panel" />
                    <corners android:radius="8dp" />
                    <stroke android:width="2dp" android:color="@color/cb_signal_cyan" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0AFFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
