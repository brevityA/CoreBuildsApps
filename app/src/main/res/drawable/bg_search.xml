<?xml version="1.0" encoding="utf-8"?>
<!-- Search field, a pill since 2.6.0 like every control beside it. Focus is a
     stroke inside the bounds so the caret and hint do not shift when focus
     arrives. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <corners android:radius="@dimen/cb_radius_pill" />
            <stroke android:width="@dimen/cb_focus_ring"
                android:color="@color/cb_signal_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_card_surface" />
            <corners android:radius="@dimen/cb_radius_pill" />
            <stroke android:width="1dp" android:color="@color/cb_divider" />
        </shape>
    </item>
</selector>
