<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogs (1.12.0): a panel with the section radius, inset like AppCompat's own. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp" android:insetRight="16dp"
    android:insetTop="16dp" android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/cb_panel" />
        <stroke android:width="1dp" android:color="@color/cb_divider" />
        <corners android:radius="20dp" />
    </shape>
</inset>
