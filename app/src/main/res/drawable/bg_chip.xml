<?xml version="1.0" encoding="utf-8"?>
<!-- A status chip on a row (Missing icons' action, the auditor's request
     state): a small cyan-tinted pill since 2.6.0. Not focusable, so it has no
     focus state - it only ever labels. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/cb_selected_fill" />
    <corners android:radius="@dimen/cb_radius_pill" />
    <stroke android:width="1dp" android:color="@color/cb_selected_edge" />
</shape>
