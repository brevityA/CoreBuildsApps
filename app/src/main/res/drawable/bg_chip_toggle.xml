<?xml version="1.0" encoding="utf-8"?>
<!-- Category filter chip: 6dp radius. Activated = cyan tint, focused = warm glow ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="false">
        <shape android:shape="rectangle">
            <solid android:color="#1A00D4FF" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/cb_signal_cyan" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1400D4FF" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cb_panel" />
                    <corners android:radius="6dp" />
                    <stroke android:width="2dp" android:color="@color/cb_signal_cyan" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_card" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#0FFFFFFF" />
        </shape>
    </item>
</selector>
