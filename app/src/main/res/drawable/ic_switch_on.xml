<?xml version="1.0" encoding="utf-8"?>
<!-- On: a filled cyan track, dark knob at the end (40 x 22dp since 1.12.0). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="40dp" android:height="22dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_signal_cyan" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:width="16dp" android:height="16dp"
        android:gravity="end|center_vertical" android:end="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/cb_cta_ink" />
        </shape>
    </item>
</layer-list>
