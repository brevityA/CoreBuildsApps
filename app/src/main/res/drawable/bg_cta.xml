<?xml version="1.0" encoding="utf-8"?>
<!--
  Signature CTA, §03: linear-gradient(135deg,#00abd3,#00d4ff).

  Focus is a stroke inside the bounds, not an inset layer. A button that grows
  when focused moves its own label, and these are the controls a D-pad user
  crosses most often.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315"
                android:startColor="@color/cb_cta_start"
                android:endColor="@color/cb_cta_end" />
            <corners android:radius="@dimen/cb_radius_button" />
            <stroke android:width="@dimen/cb_focus_ring"
                android:color="@color/cb_glow_cyan" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <corners android:radius="@dimen/cb_radius_button" />
            <stroke android:width="1dp" android:color="@color/cb_hairline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315"
                android:startColor="@color/cb_cta_start"
                android:endColor="@color/cb_cta_end" />
            <corners android:radius="@dimen/cb_radius_button" />
        </shape>
    </item>
</selector>
