<?xml version="1.0" encoding="utf-8"?>
<!-- Icon card: 10dp radius, softer border. Focus gets cyan ring + warm glow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1800D4FF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cb_panel" />
                    <corners android:radius="10dp" />
                    <stroke android:width="2dp" android:color="@color/cb_signal_cyan" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_card" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#0FFFFFFF" />
        </shape>
    </item>
</selector>
