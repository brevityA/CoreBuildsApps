<?xml version="1.0" encoding="utf-8"?>
<!-- Off: a grey track, slate knob at the start, 40 x 22dp. Sized and inset the
     API 21 way, as ic_switch_on is. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="22dp" />
            <solid android:color="@color/cb_card_focus" />
            <stroke android:width="1dp" android:color="@color/cb_divider" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="21dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/cb_slate" />
        </shape>
    </item>
</layer-list>
