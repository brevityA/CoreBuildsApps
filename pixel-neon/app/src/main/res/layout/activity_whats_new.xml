<?xml version="1.0" encoding="utf-8"?>
<!--
  What's new. The post-update counterpart of the update bar: the bar says
  one line before a build installs, this screen reads the whole highlights
  list of the build that just did, off the APK's own assets/version.json.

  Same grammar as Settings: one focusable row (Done), a ScrollView for the
  content so a long release list or a raised font scale scrolls instead of
  clipping (see test_tv_layout_fit.py), header pinned outside the scroll.
  The bullet rows are runtime content — What's New is only interesting when
  it says THIS build's changes — so the list is a container the activity
  fills from the manifest, not a stack of hand-written TextViews.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_night"
    android:orientation="vertical"
    android:padding="@dimen/cb_card_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.16"
        android:text="@string/whats_new_kicker"
        android:textColor="@color/cb_signal_cyan"
        android:textSize="@dimen/cb_text_kicker"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/whats_new_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_xs"
        android:textColor="@color/cb_ink"
        android:textSize="@dimen/cb_text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/whats_new_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_xs"
        android:visibility="gone"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/cb_space_md">

        <LinearLayout
            android:id="@+id/whats_new_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/whats_new_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_md"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="@dimen/cb_card_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whats_new_done"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_body"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
