    <dimen name="cb_button_min_width">440dp</dimen>

    <!-- Type scale. 12sp is the floor — nothing in the app renders smaller,
         because a TV is read at ~3m, not at arm's length. -->
    <dimen name="cb_text_kicker">24sp</dimen>
    <!-- TV labels need to remain readable at a 10-foot viewing distance. -->
