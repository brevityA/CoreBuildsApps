<!-- GENERATED by tools/build_scale_variants.py - do not edit by hand.

     values-sw720dp matches 4K panels that report the doubled dp box
     (1920x1080dp instead of 960x540dp). Every metric is exactly twice the base
     values/dimens.xml so both panels render the same physical picture: same
     type sizes at 3m, same focus floors, same grid column counts (the span
     arithmetic divides pane width by tile pitch, and both double).
     Edit values/dimens.xml and re-run the generator. -->
<resources>

    <!-- Screen gutters. Side padding is inset-aware (see activity_main). -->
    <dimen name="cb_gutter_side">96dp</dimen>
    <dimen name="cb_gutter_top">80dp</dimen>
    <dimen name="cb_gutter_bottom">48dp</dimen>
    <!-- Narrow fallback for 720p / legacy panels that overscan. -->
    <dimen name="cb_gutter_side_narrow">64dp</dimen>
    <!-- Tighter top/bottom gutters for the one screen whose chrome competes
         with its grid for the 540dp a 1080p panel reports: the catalogue. Every
         other screen scrolls, so it keeps the house gutters above. -->
    <dimen name="cb_gutter_top_tight">48dp</dimen>
    <dimen name="cb_gutter_bottom_tight">24dp</dimen>
    <!-- The home and wallpapers screens are two-pane on a TV: this rail holds
         the sheet's vertical stack (wordmark, CTA, entry rows, ALSO APPLIES TO,
         and on wallpapers the series chips and the export foot) while the grid
         takes the rest of the panel. Fixed width, so the pane - and therefore
         the tile columns - is derived, not guessed. -->
    <dimen name="cb_rail_width">600dp</dimen>

    <!-- Spacing rhythm. -->
    <dimen name="cb_space_xs">16dp</dimen>
    <dimen name="cb_space_sm">24dp</dimen>
    <dimen name="cb_space_md">32dp</dimen>
    <dimen name="cb_space_lg">52dp</dimen>
    <dimen name="cb_space_xl">60dp</dimen>

    <!-- Grid. The gap is delivered by the card focus inset, so tiles never
         touch even though RecyclerView adds no ItemDecoration. -->
    <dimen name="cb_card_padding">28dp</dimen>
    <dimen name="cb_card_icon">152dp</dimen>
    <!-- Brandmark dot on an icon tile. 7dp reads at 3m without
         crowding artwork that already runs to the tile edge. -->
    <dimen name="cb_brandmark_dot">14dp</dimen>
    <dimen name="cb_wp_thumb">236dp</dimen>
    <!-- Catalogue tile glyph. The design sheet's tiles are glyph-only squares:
         the name lives in the inspector and in the tile's content description,
         not under the art. The two-pane home screen gives the grid the whole
         right-hand pane, so the glyph can be the sheet's size again; the grid's
         column count is derived from this dimen and the pane width, which is
         what keeps the tiles square-proportioned on a 4K panel that reports a
         larger dp box (see values-sw720dp). -->
    <dimen name="cb_tile_icon">256dp</dimen>
    <dimen name="cb_seed_swatch">64dp</dimen>

    <!-- Radii. Chip is a pill. -->
    <dimen name="cb_radius_card">28dp</dimen>
    <dimen name="cb_radius_button">20dp</dimen>
    <dimen name="cb_radius_field">20dp</dimen>
    <dimen name="cb_radius_pill">1998dp</dimen>
    <!-- Card radius minus cb_focus_inset, so the inner fill stays concentric
         with the ring instead of looking pinched at the corners. -->
    <dimen name="cb_radius_card_inner">16dp</dimen>
    <!-- Card radius minus cb_focus_ring, for the gap layer between ring and
         card in bg_card. Keeps the three concentric shapes aligned. -->
    <dimen name="cb_radius_card_gap">22dp</dimen>

    <!-- Focus: a 3dp ring, a 3dp gap of background, then the card. The gap
