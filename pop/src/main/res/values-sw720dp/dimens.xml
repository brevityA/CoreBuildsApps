    <dimen name="cb_focus_ring">6dp</dimen>
    <dimen name="cb_focus_gap">6dp</dimen>
    <dimen name="cb_focus_inset">12dp</dimen>

    <!-- Minimum touch / D-pad target. Material floor. -->
    <dimen name="cb_target_min">96dp</dimen>

    <!-- Stacked action buttons share a minimum width so they align as a column
