<?xml version="1.0" encoding="utf-8"?>
<!--
  Selection-mode overlay for a wallpaper tile, drawn on top by the adapter.

  Inset by cb_focus_inset so the frame lands on the card edge rather than on
  the tile bounds — bg_card draws its card surface at the same inset, and the
  focus ring lives outside it. That keeps "selected" and "focused" on two
  different rectangles, so a tile can show both at once without ambiguity.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="@dimen/cb_focus_inset"
        android:top="@dimen/cb_focus_inset"
        android:right="@dimen/cb_focus_inset"
        android:bottom="@dimen/cb_focus_inset">
        <shape android:shape="rectangle">
            <solid android:color="#1F00D4FF" />
            <corners android:radius="@dimen/cb_radius_card_inner" />
            <stroke android:width="@dimen/cb_focus_ring"
                android:color="@color/cb_signal_cyan" />
        </shape>
    </item>
</layer-list>
