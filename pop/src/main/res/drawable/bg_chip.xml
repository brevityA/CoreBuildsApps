<?xml version="1.0" encoding="utf-8"?>
<!-- Kicker chip: the small mono label above a screen title. Not focusable, so
     it has no focus state — it only ever labels. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#14202B" />
    <corners android:radius="@dimen/cb_radius_field" />
    <stroke android:width="1dp" android:color="#3300D4FF" />
</shape>
