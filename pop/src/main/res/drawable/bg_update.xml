<?xml version="1.0" encoding="utf-8"?>
<!--
  Update bar. A gradient rather than a flat tint so the bar reads as a surface
  with a direction of light, matching the card treatment. Cyan border stays at
  1dp: this is a passive notice, not a control, and a heavy border would
  compete with the CTA inside it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#0F2231"
        android:endColor="#101A26"
        android:type="linear" />
    <corners android:radius="@dimen/cb_radius_card" />
    <stroke android:width="1dp" android:color="#1E3B4D" />
</shape>
