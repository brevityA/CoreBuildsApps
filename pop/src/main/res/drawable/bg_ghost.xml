<?xml version="1.0" encoding="utf-8"?>
<!-- Ghost / secondary button: transparent body, cyan edge. Focus is a stroke
     inside the bounds, matching bg_cta so both button ranks behave alike. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <corners android:radius="@dimen/cb_radius_button" />
            <stroke android:width="@dimen/cb_focus_ring"
                android:color="@color/cb_signal_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/cb_radius_button" />
            <stroke android:width="1dp" android:color="#5900D4FF" />
        </shape>
    </item>
</selector>
