<?xml version="1.0" encoding="utf-8"?>
<!--
  One suite companion: name, installed state, Downloader code. The row is the
  focus target and the verb - press launches the companion when it is on the
  TV, and says so in a toast when it is not.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/cb_card_padding">

    <TextView
        android:id="@+id/suite_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/cb_ink"
        android:textSize="@dimen/cb_text_body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/suite_item_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />

    <TextView
        android:id="@+id/suite_item_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textColor="@color/cb_signal_cyan"
        android:textSize="@dimen/cb_text_data" />
</LinearLayout>
