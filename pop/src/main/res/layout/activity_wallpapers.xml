<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallpapers browser, laid out to the approved design sheet
  (docs/design/app-ui-apply-wallpapers.png, right panel): cyan caps title with
  the wall count and the "series chips filter the grid" line under it, series
  chips, a three-column thumb grid with the name under each thumb, and the
  export affordance at the foot of the screen as a ghost pill with its
  explanatory paragraph - not in the header, where it competed with Back.

  Selection mode (long-press) still raises its own bar under the header; that is
  a mode, not chrome, and the sheet does not depict it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_night"
    android:orientation="vertical"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="@string/wp_kicker"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wp_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />
        </LinearLayout>

        <TextView
            android:id="@+id/wp_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/cb_button_min_width"
            android:minHeight="@dimen/cb_target_min"
            android:gravity="center"
            android:background="@drawable/bg_ghost"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/wp_selection_bar"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingTop="@dimen/cb_space_sm"
            android:paddingEnd="@dimen/cb_space_lg"
            android:paddingBottom="@dimen/cb_space_sm"
            android:text="@string/wp_back"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_body"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contextual selection bar: hidden until the user long-presses a tile.
         Back exits selection mode; Export N starts the export. -->
    <LinearLayout
        android:id="@+id/wp_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_sm"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/wp_back"
        android:nextFocusDown="@id/wp_chips"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/wp_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/cb_signal_cyan"
            android:textSize="@dimen/cb_text_label" />

        <TextView
            android:id="@+id/wp_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/cb_space_sm"
            android:background="@drawable/bg_chip_toggle"
            android:minHeight="@dimen/cb_target_min"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/wp_back"
            android:nextFocusDown="@id/wp_chips"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingTop="@dimen/cb_space_sm"
            android:paddingEnd="@dimen/cb_space_lg"
            android:paddingBottom="@dimen/cb_space_sm"
            android:text="@string/wp_select_all"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wp_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/cb_space_sm"
            android:background="@drawable/bg_chip_toggle"
            android:minHeight="@dimen/cb_target_min"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/wp_back"
            android:nextFocusDown="@id/wp_chips"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingTop="@dimen/cb_space_sm"
            android:paddingEnd="@dimen/cb_space_lg"
            android:paddingBottom="@dimen/cb_space_sm"
            android:text="@string/wp_clear"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wp_export_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cta"
            android:minHeight="@dimen/cb_target_min"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/wp_back"
            android:nextFocusDown="@id/wp_chips"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingTop="@dimen/cb_space_sm"
            android:paddingEnd="@dimen/cb_space_lg"
            android:paddingBottom="@dimen/cb_space_sm"
            android:text="@string/wp_export"
            android:textColor="@color/cb_cta_ink"
            android:textSize="@dimen/cb_text_label"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wp_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_md"
        android:clipToPadding="false"
        android:nextFocusUp="@id/wp_selection_bar"
        android:nextFocusDown="@id/wp_grid"
        android:orientation="horizontal" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wp_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cb_space_sm"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:nextFocusUp="@id/wp_chips"
        android:nextFocusDown="@id/wp_export" />

    <!-- The sheet's foot: the export affordance and the paragraph that says
         what it is for, under the grid rather than in the header. -->
    <TextView
        android:id="@+id/wp_export"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/cb_target_min"
        android:layout_marginTop="@dimen/cb_space_sm"
        android:background="@drawable/bg_ghost"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:nextFocusUp="@id/wp_grid"
        android:paddingStart="@dimen/cb_space_lg"
        android:paddingTop="@dimen/cb_space_sm"
        android:paddingEnd="@dimen/cb_space_lg"
        android:paddingBottom="@dimen/cb_space_sm"
        android:text="@string/wp_export"
        android:textAllCaps="true"
        android:letterSpacing="0.06"
        android:textColor="@color/cb_signal_cyan"
        android:textSize="@dimen/cb_text_label"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wp_export_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_xs"
        android:lineSpacingExtra="3dp"
        android:maxWidth="620dp"
        android:text="@string/wp_export_sub"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />
</LinearLayout>
