<?xml version="1.0" encoding="utf-8"?>
<!--
  One icon tile.

  A pale dot in the icon's top corner marks a tile whose glyph is a drawn
  brandmark rather than a letter in a container. 526 of the 940 icons are
  monograms, and until this there was no way to tell the two apart in the grid
  short of recognising the mark. The "Brandmarks" chip filters to the ones that
  carry it.

  The card surface is drawn inset by cb_focus_inset inside bg_card, so the
  padding here is measured from the tile bounds and lands ~8dp inside the
  visible card. minHeight keeps the D-pad target at the 48dp floor without
  stretching the artwork.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusUp="@id/search"
    android:gravity="center_horizontal"
    android:minHeight="@dimen/cb_target_min"
    android:orientation="vertical"
    android:padding="@dimen/cb_card_padding">

    <!--
        The artwork and its brandmark dot share a FrameLayout so the dot can sit
        in the corner of the icon rather than the corner of the tile, which on a
        two-line label would put it beside the text.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/icon_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cb_card_icon"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <View
            android:id="@+id/icon_brandmark"
            android:layout_width="@dimen/cb_brandmark_dot"
            android:layout_height="@dimen/cb_brandmark_dot"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_brandmark_dot"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/icon_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_sm"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="@color/cb_ink"
        android:textSize="@dimen/cb_text_label" />
</LinearLayout>
