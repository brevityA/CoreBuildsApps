<?xml version="1.0" encoding="utf-8"?>
<!--
  TV-first catalogue, laid out to the approved design sheet
  (docs/design/app-ui-apply-wallpapers.png) as a landscape two-pane screen,
  because a TV is 16:9 and the sheet's panel is portrait.

  LEFT RAIL (cb_rail_width, fixed): the sheet's vertical stack - cyan caps
  wordmark and the icon/component count, the Apply CTA with the detected
  launchers under it, the three entry rows with their subtitles, and the
  ALSO APPLIES TO kicker over its launcher chips. The rail has the panel's full
  height to spend, so the rows carry title over subtitle exactly as drawn.

  RIGHT PANE (the remainder): picker hint in icon-picker mode, the full-width
  search field, the category chips and the glyph grid, which takes every dp the
  chrome above it leaves - two rows of square-ish tiles on a 1080p panel. The
  grid's column count is derived in MainActivity from the pane width and
  cb_tile_icon, so a 4K panel that reports a larger dp box gets the same
  proportions (values-sw720dp doubles the metrics; the ratio holds).

  The update bar spans both panes at the top: it is the one thing on the screen
  that is wider than the rail and more urgent than the grid.

  Focus: one vertical chain, apply_button -> update_bar -> the rail's rows
  (art style, wallpapers, settings, about) ->
  the band -> search -> chip_row -> grid, with LEFT/RIGHT crossing between rail
  and pane geometrically. update_bar and apply_targets_band are GONE unless
  something shows them and focusable="false" while hidden, because
  isFocusable() ignores visibility and a hidden focusable stop strands the
  cursor - see MainActivity.syncFocusChain(), which rewrites every edge that
  routes through them at the moment their visibility changes.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingStart="@dimen/cb_gutter_side"
    android:paddingEnd="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <LinearLayout
        android:id="@+id/update_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_xs"
        android:background="@drawable/bg_update"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/apply_button"
        android:nextFocusDown="@id/style_entry"
        android:orientation="horizontal"
        android:paddingStart="@dimen/cb_space_md"
        android:paddingEnd="@dimen/cb_space_md"
        android:paddingTop="@dimen/cb_space_xs"
        android:paddingBottom="@dimen/cb_space_xs"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/update_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/update_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/update_sub_download"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />

            <!--
                The first release highlight from version.json, one line,
                ellipsised. Gone unless the manifest carries highlights, and
                mutually exclusive with update_sub: MainActivity shows one or
                the other, never both.

                That is a height rule, not a styling one. This bar is fixed
                chrome on a screen whose grid is the weighted remainder of
                540dp, and the full bullet list (version.json currently carries
                eight) is ~160dp on its own - shown in full it pushed the grid
                to zero height, which is the "lists disappeared" symptom with a
                network callback as the trigger. One line keeps the bar at
                ~61dp, and the whole list is on the release page the Download
                button is fetching from.
            -->
            <TextView
                android:id="@+id/update_highlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/update_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/cb_target_min"
            android:gravity="center"
            android:layout_marginStart="@dimen/cb_space_md"
            android:background="@drawable/bg_cta"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/apply_button"
            android:nextFocusDown="@id/style_entry"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingEnd="@dimen/cb_space_lg"
            android:paddingTop="@dimen/cb_space_sm"
            android:paddingBottom="@dimen/cb_space_sm"
            android:text="@string/update_download"
            android:textColor="@color/cb_cta_ink"
            android:textSize="@dimen/cb_text_body"
            android:textStyle="bold" />

        <!-- Dismiss for this session. Not decoration: while the bar is up it
             also hides the header's launcher list and the ALSO APPLIES TO band
             (see showUpdateAvailable), because on a 540dp panel the bar, the
             band and a full row of tiles do not all fit, and the tiles are the
             screen. This is the press that gives them back. -->
        <TextView
            android:id="@+id/update_later"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/cb_target_min"
            android:gravity="center"
            android:layout_marginStart="@dimen/cb_space_sm"
            android:background="@drawable/bg_ghost"
            android:clickable="true"
            android:focusable="true"
            android:nextFocusUp="@id/apply_button"
            android:nextFocusDown="@id/style_entry"
            android:paddingStart="@dimen/cb_space_lg"
            android:paddingEnd="@dimen/cb_space_lg"
            android:paddingTop="@dimen/cb_space_sm"
            android:paddingBottom="@dimen/cb_space_sm"
            android:text="@string/update_later"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_body"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- LEFT RAIL -->
        <LinearLayout
            android:layout_width="@dimen/cb_rail_width"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/cb_space_md"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="@string/kicker"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />

            <TextView
                android:id="@+id/apply_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/cb_target_min"
                android:layout_marginTop="@dimen/cb_space_md"
                android:background="@drawable/bg_cta"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:nextFocusDown="@id/update_bar"
                android:paddingStart="@dimen/cb_space_lg"
                android:paddingTop="@dimen/cb_space_sm"
                android:paddingEnd="@dimen/cb_space_lg"
                android:paddingBottom="@dimen/cb_space_sm"
                android:text="@string/cta_apply"
                android:textColor="@color/cb_cta_ink"
                android:textSize="@dimen/cb_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/apply_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data" />

            <!-- The sheet's three entry rows, title over subtitle: the rail is
                 the one place on a 540dp panel with the height for it. The
                 wrapper is what icon-picker mode hides in one go. -->
            <LinearLayout
                android:id="@+id/wallpapers_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:orientation="vertical">

                <!-- Art style, on the home screen rather than in Settings:
                     the switch decides what every app on the launcher looks
                     like, so it sits next to Apply. Same switch row as
                     Settings' set_banner_row, and the two read one pref. -->
                <LinearLayout
                    android:id="@+id/style_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/cb_target_min"
                    android:nextFocusUp="@id/update_bar"
                    android:nextFocusDown="@id/wallpapers_entry"
                    android:orientation="horizontal"
                    android:padding="@dimen/cb_card_padding">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/art_style_label"
                            android:textColor="@color/cb_ink"
                            android:textSize="@dimen/cb_text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/style_entry_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/cb_slate"
                            android:textSize="@dimen/cb_text_data" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/style_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:duplicateParentState="true"
                        android:focusable="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wallpapers_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_marginTop="@dimen/cb_space_xs"
                    android:minHeight="@dimen/cb_target_min"
                    android:nextFocusUp="@id/style_entry"
                    android:nextFocusDown="@id/settings_entry"
                    android:orientation="vertical"
                    android:padding="@dimen/cb_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wp_entry"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wallpapers_entry_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_data" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settings_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_xs"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minHeight="@dimen/cb_target_min"
                    android:nextFocusUp="@id/wallpapers_entry"
                    android:nextFocusDown="@id/about_entry"
                    android:orientation="vertical"
                    android:padding="@dimen/cb_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_label"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/settings_entry_sub"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_data" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/about_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_xs"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minHeight="@dimen/cb_target_min"
                    android:nextFocusUp="@id/settings_entry"
                    android:nextFocusDown="@id/apply_targets"
                    android:orientation="vertical"
                    android:padding="@dimen/cb_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_label"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/about_entry_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_data" />
                </LinearLayout>
            </LinearLayout>

            <!-- ALSO APPLIES TO: kicker over its chips, as drawn. Gone as a unit
                 with nothing to show; in icon-picker mode the same band carries
                 the banner/square shape chips with picker_hint as their label.
                 focusable="false" so the hidden band can never hold the cursor;
                 afterDescendants on the list so a shown band hands focus to its
                 first chip. -->
            <LinearLayout
                android:id="@+id/apply_targets_band"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_md"
                android:focusable="false"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/apply_targets_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.18"
                    android:text="@string/cta_also_applies"
                    android:textColor="@color/cb_signal_cyan"
                    android:textSize="@dimen/cb_text_kicker"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/apply_targets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cb_space_xs"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:nextFocusUp="@id/about_entry"
                    android:nextFocusDown="@id/search"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT PANE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

    <TextView
        android:id="@+id/picker_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cb_space_xs"
        android:text="@string/picker_hint"
        android:textColor="@color/cb_signal_cyan"
        android:textSize="@dimen/cb_text_label"
        android:visibility="gone" />

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/cb_target_min"
                android:background="@drawable/bg_search"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:nextFocusUp="@id/apply_targets"
                android:nextFocusDown="@id/chip_row"
                android:paddingStart="@dimen/cb_space_md"
                android:paddingEnd="@dimen/cb_space_md"
                android:paddingTop="@dimen/cb_space_sm"
                android:paddingBottom="@dimen/cb_space_sm"
                android:textColor="@color/cb_ink"
                android:textColorHint="@color/cb_slate"
                android:textSize="@dimen/cb_text_label" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chip_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:clipToPadding="false"
                android:nextFocusUp="@id/search"
                android:nextFocusDown="@id/grid"
                android:orientation="horizontal" />

    <!-- No-results state. Without this a filter with no match renders an empty
         grid and gives the user nothing to undo. -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/cb_space_xl"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_section"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/empty_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cb_space_xs"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:maxWidth="620dp"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_label" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cb_space_md"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/empty_clear_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/cb_target_min"
                android:gravity="center"
                android:layout_marginEnd="@dimen/cb_space_sm"
                android:background="@drawable/bg_cta"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingStart="@dimen/cb_space_lg"
                android:paddingEnd="@dimen/cb_space_lg"
                android:paddingTop="@dimen/cb_space_sm"
                android:paddingBottom="@dimen/cb_space_sm"
                android:text="@string/empty_clear_search"
                android:textColor="@color/cb_cta_ink"
                android:textSize="@dimen/cb_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/empty_clear_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/cb_target_min"
                android:gravity="center"
                android:background="@drawable/bg_ghost"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingStart="@dimen/cb_space_lg"
                android:paddingEnd="@dimen/cb_space_lg"
                android:paddingTop="@dimen/cb_space_sm"
                android:paddingBottom="@dimen/cb_space_sm"
                android:text="@string/empty_clear_filter"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_body"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cb_space_md"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:nextFocusUp="@id/chip_row" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
