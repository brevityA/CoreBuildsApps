<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      0.4's connected-TV feature set. QUERY_ALL_PACKAGES gives the private,
      sideload-only prototype visibility of every installed package; the four
      narrow intent queries below remain as explicit contracts for launchers
      and icon packs. PACKAGE_USAGE_STATS is an AppOps permission the owner must
      grant in Android Settings; the app never forces it. Network wallpapers are
      fetched only from a URL the owner types. POST_NOTIFICATIONS is requested
      at runtime on Android 13+.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <!-- A pack's own icon browser, for one app's artwork (Customise per app). -->
        <intent>
            <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/core_builds_banner"
        android:icon="@drawable/core_builds_mark"
        android:label="@string/app_name"
        android:roundIcon="@drawable/core_builds_mark"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoreBuildsLauncher">

        <activity
            android:name=".LauncherActivity"
            android:banner="@drawable/core_builds_banner"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask">

            <!-- System HOME selection. Never force default-home state. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Visible in Android TV / Google TV app lists. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Also openable from standard Android app drawers. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Optional fallback for TVs that allow a HOME app to start after boot.
          The receiver checks the saved setting and the system's current HOME
          resolution before doing anything; it never changes the default role.
        -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
