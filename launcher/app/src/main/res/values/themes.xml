<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CoreBuildsLauncher" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cb_background</item>
        <item name="android:colorBackground">@color/cb_background</item>
        <item name="android:colorAccent">@color/cb_cyan</item>
        <item name="android:statusBarColor">@color/cb_background</item>
        <item name="android:navigationBarColor">@color/cb_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:colorControlHighlight">#5500D4FF</item>
        <!-- The home draws its own backdrop; no window animation between Home presses. -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
