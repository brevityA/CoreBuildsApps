<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_void">

    <androidx.media3.ui.PlayerView
        android:id="@+id/preview_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:contentDescription="@string/video_preview_description"
        app:resize_mode="zoom"
        app:show_buffering="when_playing"
        app:use_controller="true"
        app:controller_show_timeout_ms="3500"
        app:controller_hide_on_touch="false" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/procedural_overlay">

        <TextView
            android:id="@+id/preview_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cb_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/cb_cyan"
            android:fontFamily="monospace"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/preview_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/cb_text_secondary"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
