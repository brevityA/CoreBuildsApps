# Device scans are per-machine, not repo state
tools/device_scan.json
tools/device_scan.txt

# Local render venvs for the icon generators (per-machine, not repo state)
.venv-pop/
.venv/

# Kotlin 2 (AGP 9 built-in Kotlin) writes per-project session data and
# daemon crash logs here; none of it is source
.kotlin/

# Core Views render output: frames, plans and MP4s are per-machine. Rendered
# renditions go to the `views` release lane, never into git.
views/render/
