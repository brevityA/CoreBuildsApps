<?xml version="1.0" encoding="utf-8"?>
<!--
  The brandmark marker: a small pale dot in the top corner of a tile whose
  glyph is a drawn mark rather than a letter in a container.

  Deliberately cb_ink and not cb_signal_cyan. The focus ring in bg_card is
  signal cyan, and a cyan dot on a focused tile reads as part of the ring
  rather than as a property of the icon. Ink is the one palette entry that is
  bright enough to survive a 3m viewing distance without competing with focus.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/cb_ink" />
</shape>
