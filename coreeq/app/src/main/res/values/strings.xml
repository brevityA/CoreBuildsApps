    <!-- Capability screen -->
    <string name="capability_title">Core EQ · Capability</string>
    <string name="capability_heading">What this device will accept</string>
    <string name="capability_sub">Android has no global equaliser API. Each row is a path we probe, and the verdict is the truth.</string>
    <string name="capability_verdict_title">Verdict on this set</string>
    <string name="capability_fallback_title">If nothing applies, the curve still travels</string>
    <string name="capability_fallback_desc">Export the profile and set the numbers in the TV\'s own sound settings, or in the player\'s built-in equaliser. It is the same curve.</string>
    <string name="capability_discovery_title">DUMP discovery (optional)</string>
    <string name="capability_discovery_granted">Granted · some players that never announce a session can be found and corrected. Not all: YouTube is reported not to be reachable this way.</string>
    <string name="capability_discovery_denied">Not granted · run this once from a computer with ADB, then correction can reach some players that never announce a session:</string>
    <string name="capability_discovery_command">adb shell pm grant tv.corebuilds.eq android.permission.DUMP</string>

