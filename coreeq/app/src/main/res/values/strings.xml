    <!-- Measure screen -->
    <string name="measure_title">Core EQ · Measure</string>
    <string name="measure_heading">Hold the room still for 20 seconds</string>
    <string name="measure_sub">The TV plays a sine sweep. The remote microphone listens. Nothing leaves this device.</string>
    <string name="measure_step1_title">Press OK to start the stimulus</string>
    <string name="measure_step1_sub">One frequency at a time, so it beats the room noise. Loud enough to hear over the room, quiet enough to live with.</string>
    <string name="measure_step2_title">Point the remote at your seat</string>
    <string name="measure_step2_sub">Where your ears are, not at the TV. The remote microphone is the only microphone this can use.</string>
    <string name="measure_step3_title">Keep the room quiet while the bar fills</string>
    <string name="measure_step3_sub">Talking, footsteps and the kitchen fan land in the same measurement. Dips that are cancellations get left alone.</string>
    <string name="measure_progress_title">Capture progress</string>
    <string name="measure_stop">Stop</string>
    <string name="measure_start_over">Start over</string>
    <string name="measure_save">Save profile</string>

