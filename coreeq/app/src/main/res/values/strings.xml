    <!-- Measure screen -->
    <string name="measure_title">Core EQ · Measure</string>
    <string name="measure_heading">Keep the room quiet for 13 seconds</string>
    <string name="measure_sub">The TV plays a sine sweep. The remote microphone listens. Nothing leaves this device.</string>
    <string name="measure_step1_title">Tell Core EQ about the room</string>
    <string name="measure_step1_sub">Room size sets where full correction stops. Turn off the TV\'s own sound effects first (AI sound, bass boost, virtual surround): they would be measured too. If your AVR or soundbar already calibrates the room, do not stack Core EQ on it: measure and export the profile instead.</string>
    <string name="measure_step2_title">Point the remote at your seat</string>
    <string name="measure_step2_sub">Hold it where your head is, microphone end up, and keep it still until the bar fills.</string>
    <string name="measure_step3_title">Keep the room quiet while the bar fills</string>
    <string name="measure_step3_sub">Talking, footsteps and fans land in the same measurement. A sweep the room drowns out is refused, not guessed at.</string>
