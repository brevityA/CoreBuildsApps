<?xml version="1.0" encoding="utf-8"?>
<!--
  Card and full-width row background with the Brand Guide v1.0 §05 focus ring.
  Focused rows take the panel colour (1.12.0), as pills and rail items do.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <stroke android:width="@dimen/cb_focus_ring" android:color="@color/cb_signal_cyan" />
            <corners android:radius="@dimen/cb_radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_card_surface" />
            <stroke android:width="1dp" android:color="@color/cb_hairline" />
            <corners android:radius="@dimen/cb_radius_card" />
        </shape>
    </item>
</selector>
