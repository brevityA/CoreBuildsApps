<?xml version="1.0" encoding="utf-8"?>
<!-- One option in a segmented control: cyan at 16% when chosen, the ring under focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_selected_fill" />
            <stroke android:width="@dimen/cb_focus_ring" android:color="@color/cb_focus_ring" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <stroke android:width="@dimen/cb_focus_ring" android:color="@color/cb_focus_ring" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_selected_fill" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
</selector>
