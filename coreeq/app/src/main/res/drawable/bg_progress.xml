<?xml version="1.0" encoding="utf-8"?>
<!-- A capture's progress: an 8dp pill track in the void colour, filled with the brand gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_void" />
            <stroke android:width="1dp" android:color="@color/cb_divider" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <gradient android:angle="0"
                    android:startColor="@color/cb_cta_start"
                    android:endColor="@color/cb_cta_end" />
                <corners android:radius="@dimen/cb_radius_pill" />
            </shape>
        </scale>
    </item>
</layer-list>
