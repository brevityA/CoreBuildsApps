<?xml version="1.0" encoding="utf-8"?>
<!-- Off: a grey track, slate knob at the start (40 x 22dp since 1.12.0). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="40dp" android:height="22dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_card_focus" />
            <stroke android:width="1dp" android:color="@color/cb_divider" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:width="16dp" android:height="16dp"
        android:gravity="start|center_vertical" android:start="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/cb_slate" />
        </shape>
    </item>
</layer-list>
