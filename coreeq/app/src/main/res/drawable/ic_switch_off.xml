<?xml version="1.0" encoding="utf-8"?>
<!-- Off: outlined slate track, knob at the start. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="36dp" android:height="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/cb_slate" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:width="12dp" android:height="12dp"
        android:gravity="start|center_vertical" android:start="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/cb_slate" />
        </shape>
    </item>
</layer-list>
