<?xml version="1.0" encoding="utf-8"?>
<!-- The rail: the void colour, with a hairline along its right edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_void" />
        </shape>
    </item>
    <item android:gravity="end|fill_vertical" android:width="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_divider" />
        </shape>
    </item>
</layer-list>
