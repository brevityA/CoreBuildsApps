<?xml version="1.0" encoding="utf-8"?>
<!-- A rail item: no body at rest, a panel body for the current screen, the ring under focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <stroke android:width="@dimen/cb_focus_ring" android:color="@color/cb_focus_ring" />
            <corners android:radius="@dimen/cb_radius_rail_item" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <corners android:radius="@dimen/cb_radius_rail_item" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/cb_radius_rail_item" />
        </shape>
    </item>
</selector>
