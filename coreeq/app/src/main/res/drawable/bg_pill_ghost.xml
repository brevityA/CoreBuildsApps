<?xml version="1.0" encoding="utf-8"?>
<!-- A secondary pill: no body at rest, a 35% cyan edge; the ring and a panel body under focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cb_panel" />
            <stroke android:width="@dimen/cb_focus_ring" android:color="@color/cb_focus_ring" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/cb_hairline" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/cb_ghost_edge" />
            <corners android:radius="@dimen/cb_radius_pill" />
        </shape>
    </item>
</selector>
