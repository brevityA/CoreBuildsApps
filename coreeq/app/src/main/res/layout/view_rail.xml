<?xml version="1.0" encoding="utf-8"?>
<!--
  The rail (1.12.0): every screen with a rail includes this, as the first
  child of a RailStageLayout. Its first row is the brand and the way Home;
  the rest are the screens Home used to list. RailNav wires the clicks and
  marks the current screen (activated); RailStageLayout keeps the D-pad in
  the rail on Up and Down and moves it to the stage on Right.
  The ids are the Home menu's ids, so the screens they open did not change.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rail"
    android:layout_width="@dimen/cb_nav_rail_width"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_rail"
    android:paddingStart="10dp"
    android:paddingEnd="11dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:accessibilityPaneTitle="@string/rail_navigation">

    <Button
        android:id="@+id/rail_home"
        style="@style/Widget.CoreEQ.RailItem.Home"
        android:drawableStart="@drawable/ic_nav_home"
        android:contentDescription="@string/rail_home_description"
        android:text="@string/rail_home" />

    <TextView
        style="@style/CoreEQ.MenuHeading"
        android:paddingStart="12dp"
        android:paddingBottom="4dp"
        android:text="@string/menu_sound" />

    <Button
        android:id="@+id/btn_nav_manual_eq"
        style="@style/Widget.CoreEQ.RailItem"
        android:drawableStart="@drawable/ic_nav_manual_eq"
        android:text="@string/action_manual_eq" />

    <Button
        android:id="@+id/btn_nav_extras"
        style="@style/Widget.CoreEQ.RailItem"
        android:drawableStart="@drawable/ic_nav_extras"
        android:text="@string/action_extras" />

    <Button
        android:id="@+id/btn_nav_content_type"
        style="@style/Widget.CoreEQ.RailItem"
        android:drawableStart="@drawable/ic_nav_content_type"
        android:text="@string/action_content_type" />

    <TextView
        style="@style/CoreEQ.MenuHeading"
        android:layout_marginTop="14dp"
        android:paddingStart="12dp"
        android:paddingBottom="4dp"
        android:text="@string/menu_setup" />

    <Button
        android:id="@+id/btn_nav_profiles"
        style="@style/Widget.CoreEQ.RailItem"
        android:drawableStart="@drawable/ic_nav_profiles"
        android:text="@string/action_profiles" />

    <Button
        android:id="@+id/btn_nav_capability"
        style="@style/Widget.CoreEQ.RailItem"
        android:drawableStart="@drawable/ic_nav_capability"
        android:text="@string/action_capability" />

    <Button
        android:id="@+id/btn_nav_setup"
        style="@style/Widget.CoreEQ.RailItem"
        android:drawableStart="@drawable/ic_nav_setup"
        android:contentDescription="@string/action_setup"
        android:text="@string/rail_setup" />

    <Button
        android:id="@+id/btn_nav_companion"
        style="@style/Widget.CoreEQ.RailItem"
        android:drawableStart="@drawable/ic_nav_companion"
        android:text="@string/action_companion" />

    <Button
        android:id="@+id/btn_nav_display_calibration"
        style="@style/Widget.CoreEQ.RailItem"
        android:drawableStart="@drawable/ic_nav_display"
        android:text="@string/action_display_calibration" />
</LinearLayout>
