<?xml version="1.0" encoding="utf-8"?>
<!-- First run (restyled 1.12.0; no rail: it is a guide, not a place). The three
     steps do not fit 540dp, so each is a focusable card with the focus ring:
     Up from Start walks back through them and the list scrolls to each, where
     before the only way to scroll was an invisible focus stop. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingLeft="@dimen/cb_gutter_side"
    android:paddingRight="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <TextView
        style="@style/CoreEQ.Eyebrow"
        android:text="@string/first_run_kicker" />

    <TextView
        style="@style/CoreEQ.Title"
        android:layout_marginTop="2dp"
        android:text="@string/first_run_title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/first_run_intro"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data" />

    <ScrollView
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/cb_space_md"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="@dimen/cb_space_xl"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:focusable="true"
                android:stateListAnimator="@animator/focus_raise"
                android:padding="@dimen/cb_space_md">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/first_run_step_measure_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_label"
                    android:textFontWeight="600" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/first_run_step_measure_body"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
                <TextView
                    android:id="@+id/first_run_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/cb_signal_cyan"
                    android:textSize="@dimen/cb_text_data"
                    android:textFontWeight="600" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:focusable="true"
                android:stateListAnimator="@animator/focus_raise"
                android:padding="@dimen/cb_space_md"
                android:layout_marginTop="@dimen/cb_space_sm">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/first_run_step_result_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_label"
                    android:textFontWeight="600" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/first_run_step_result_body"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:focusable="true"
                android:stateListAnimator="@animator/focus_raise"
                android:padding="@dimen/cb_space_md"
                android:layout_marginTop="@dimen/cb_space_sm">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/first_run_adb_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_label"
                    android:textFontWeight="600" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/first_run_adb_body"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_first_run_measure"
        style="@style/Widget.CoreEQ.Pill.Cta"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/cb_space_sm"
        android:stateListAnimator="@animator/focus_raise"
        android:text="@string/first_run_measure_now" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_first_run_setup"
            style="@style/CoreEQ.ActionRow"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/first_run_setup_help" />
        <Button
            android:id="@+id/btn_first_run_later"
            style="@style/CoreEQ.ActionRow"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cb_space_sm"
            android:text="@string/first_run_later" />
    </LinearLayout>
</LinearLayout>
