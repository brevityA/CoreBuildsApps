<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_night"
    android:keepScreenOn="true">

    <!-- Full-screen test pattern renderer -->
    <tv.corebuilds.eq.display.TestPatternView
        android:id="@+id/pattern_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Instruction overlay: bottom sheet with step info and navigation -->
    <LinearLayout
        android:id="@+id/calibration_instruction_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/cb_gutter_side"
        android:layout_marginEnd="@dimen/cb_gutter_side"
        android:layout_marginBottom="@dimen/cb_gutter_bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="@dimen/cb_space_lg">

        <TextView
            android:id="@+id/text_calibration_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_data"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/text_calibration_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/cb_signal_cyan"
            android:textSize="@dimen/cb_text_section"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_calibration_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cb_space_xs"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_label"
            android:lineSpacingMultiplier="1.3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cb_space_md"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_calibration_toggle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginEnd="@dimen/cb_space_sm"
                android:background="@drawable/bg_ghost"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                android:text="@string/calibration_toggle_overlay"
                android:paddingStart="@dimen/cb_card_padding"
                android:paddingEnd="@dimen/cb_card_padding"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btn_calibration_prev"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginEnd="@dimen/cb_space_sm"
                android:background="@drawable/bg_ghost"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                android:text="@string/calibration_prev"
                android:paddingStart="@dimen/cb_card_padding"
                android:paddingEnd="@dimen/cb_card_padding"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btn_calibration_next"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/cb_target_min"
                android:background="@drawable/bg_cta"
                android:textColor="@color/cb_cta_ink"
                android:textSize="@dimen/cb_text_data"
                android:text="@string/calibration_next"
                android:paddingStart="@dimen/cb_card_padding"
                android:paddingEnd="@dimen/cb_card_padding"
                android:focusable="true"
                android:focusableInTouchMode="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
