<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_night"
    android:keepScreenOn="true">

    <!-- Full-screen test pattern renderer -->
    <tv.corebuilds.eq.display.TestPatternView
        android:id="@+id/pattern_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Instruction overlay: bottom sheet with step info and navigation -->
    <LinearLayout
        android:id="@+id/calibration_instruction_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_calibration_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cb_slate"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/text_calibration_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/cb_signal_cyan"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_calibration_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/cb_slate"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_calibration_toggle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_ghost"
                android:textColor="@color/cb_slate"
                android:textSize="14sp"
                android:text="@string/calibration_toggle_overlay"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btn_calibration_prev"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_ghost"
                android:textColor="@color/cb_slate"
                android:textSize="14sp"
                android:text="@string/calibration_prev"
                android:focusable="true"
                android:focusableInTouchMode="false" />

            <Button
                android:id="@+id/btn_calibration_next"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_cta"
                android:textColor="@color/cb_night"
                android:textSize="14sp"
                android:text="@string/calibration_next"
                android:focusable="true"
                android:focusableInTouchMode="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
