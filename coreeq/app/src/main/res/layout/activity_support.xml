<?xml version="1.0" encoding="utf-8"?>
<!--
  Support (opened from the Capability screen's Support card). The header is
  the Capability screen's; below it, what support changes on the left and the
  two codes on the right, side by side because a TV is wide and short.

  The codes take no focus: a phone reads them, a remote cannot press them.
  Done is the screen's one stop.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingLeft="@dimen/cb_gutter_side"
    android:paddingRight="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/support_title"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_kicker"
        android:fontFamily="monospace"
        android:textAllCaps="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/support_heading"
        android:textColor="@color/cb_ink"
        android:textSize="@dimen/cb_text_title"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/cb_space_md">

        <!-- Left: why, what it changes, and the way out -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="@dimen/cb_space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/support_body"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_body"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/support_mode"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_data"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="@dimen/cb_space_md" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/support_footer"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btn_support_done"
                android:layout_width="@dimen/cb_button_min_width"
                android:layout_height="@dimen/cb_target_min"
                android:background="@drawable/bg_cta"
                android:text="@string/support_done"
                android:textColor="@color/cta_text"
                android:textSize="@dimen/cb_text_label"
                android:textStyle="bold"
                android:focusable="true"
                android:layout_marginTop="@dimen/cb_space_sm" />
        </LinearLayout>

        <!-- Right: the two codes. White quiet zones come from the bitmaps
             (ui/QrBitmap), so the dark card cannot swallow one. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/cb_card_padding">

            <ImageView
                android:id="@+id/support_sponsors_qr"
                android:layout_width="@dimen/cb_support_qr"
                android:layout_height="@dimen/cb_support_qr"
                android:contentDescription="@string/support_sponsors_qr_hint"
                android:focusable="false"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support_sponsors_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_section"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/cb_space_sm" />

            <TextView
                android:id="@+id/support_sponsors_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/cb_card_padding"
            android:layout_marginStart="@dimen/cb_space_md">

            <ImageView
                android:id="@+id/support_kofi_qr"
                android:layout_width="@dimen/cb_support_qr"
                android:layout_height="@dimen/cb_support_qr"
                android:contentDescription="@string/support_kofi_qr_hint"
                android:focusable="false"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support_kofi_label"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_section"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/cb_space_sm" />

            <TextView
                android:id="@+id/support_kofi_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
