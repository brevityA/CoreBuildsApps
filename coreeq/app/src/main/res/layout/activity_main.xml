<?xml version="1.0" encoding="utf-8"?>
<!--
  Home (1.12.0, rail and stage). The rail on the left opens every other
  screen; the stage is about the room you are in: the active profile, the
  three things changed most often (Correction, Mode, Re-measure), what the
  correction looks like and what the service last did. Everything fits the
  960 x 540dp box without scrolling; the graph takes whatever height is left,
  so the status line below it is never clipped.
-->
<tv.corebuilds.eq.ui.RailStageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/cb_night">

    <include layout="@layout/view_rail" />

    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/cb_stage_start"
        android:paddingEnd="@dimen/cb_stage_end"
        android:paddingTop="@dimen/cb_stage_top"
        android:paddingBottom="@dimen/cb_stage_bottom"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- Update bar. GONE until the release feed names a newer build: say
             which version, then offer Update or Later. Later is remembered
             per version, so it does not nag. -->
        <LinearLayout
            android:id="@+id/update_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_section"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/cb_space_sm">

            <TextView
                android:id="@+id/update_bar_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                tools:text="Core EQ 1.3.1 is available" />

            <Button
                android:id="@+id/update_bar_install"
                style="@style/Widget.CoreEQ.Pill.Cta"
                android:layout_height="@dimen/cb_pill_compact"
                android:text="@string/update_now"
                android:layout_marginStart="@dimen/cb_space_sm" />

            <Button
                android:id="@+id/update_bar_later"
                style="@style/Widget.CoreEQ.Pill.Ghost"
                android:layout_height="@dimen/cb_pill_compact"
                android:text="@string/update_later"
                android:layout_marginStart="@dimen/cb_space_xs" />
        </LinearLayout>

        <!-- 1.3.2: the on-screen card needs "Display over other apps". GONE
             while the card can be drawn, while the notice is off, or once
             Later was pressed. Same shape as the update bar above. -->
        <LinearLayout
            android:id="@+id/card_permission_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_section"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/cb_space_sm">

            <TextView
                android:id="@+id/card_permission_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_card_permission"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data" />

            <Button
                android:id="@+id/card_permission_allow"
                style="@style/Widget.CoreEQ.Pill.Cta"
                android:layout_height="@dimen/cb_pill_compact"
                android:text="@string/home_card_allow"
                android:layout_marginStart="@dimen/cb_space_sm" />

            <Button
                android:id="@+id/card_permission_later"
                style="@style/Widget.CoreEQ.Pill.Ghost"
                android:layout_height="@dimen/cb_pill_compact"
                android:text="@string/update_later"
                android:layout_marginStart="@dimen/cb_space_xs" />
        </LinearLayout>

        <!-- The active profile: its name, the playback badge, and Re-measure. -->
        <LinearLayout
            android:id="@+id/card_active_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/header_kicker"
                    style="@style/CoreEQ.Eyebrow"
                    android:text="@string/home_kicker" />

                <TextView
                    android:id="@+id/text_active_profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_profile"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_stage_title"
                    android:textFontWeight="600"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:accessibilityHeading="true" />
            </LinearLayout>

            <!-- Playback hint only: a configured output-mix effect plus
                 reported playback is not proof of end-to-end coverage. -->
            <LinearLayout
                android:id="@+id/badge_correction"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_idle_badge"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="@dimen/cb_space_sm"
                android:focusable="false"
                android:visibility="gone">

                <View
                    android:id="@+id/badge_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/badge_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/indicator_standby"
                    android:textColor="@color/cb_signal_cyan"
                    android:textSize="@dimen/cb_text_kicker"
                    android:textFontWeight="600" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_remeasure"
                style="@style/Widget.CoreEQ.Pill.Cta"
                android:drawableStart="@drawable/ic_action_mic"
                android:drawableTint="@color/cb_cta_ink"
                android:drawablePadding="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:text="@string/action_remeasure"
                android:layout_marginStart="@dimen/cb_space_sm" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_active_profile_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_profile_sub"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_data"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />

        <!-- The three switches: Correction, the A/B comparison, Mode. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:layout_marginTop="@dimen/cb_space_md">

            <Button
                android:id="@+id/btn_toggle_correction"
                style="@style/Widget.CoreEQ.Pill.Switch"
                android:text="@string/correction_off" />

            <!--
                A/B switch (1.7.0). Hidden while correction is off, where it
                would mean nothing, and while no profile exists. The bypass it
                controls keeps the correction's average level, so the
                comparison is shape only, not "which is louder".
            -->
            <Button
                android:id="@+id/btn_ab_bypass"
                style="@style/Widget.CoreEQ.Pill.Ghost"
                android:drawableStart="@drawable/ic_action_compare"
                android:drawableTint="@color/cb_signal_cyan"
                android:drawablePadding="8dp"
                android:paddingStart="16dp"
                android:visibility="gone"
                android:text="@string/ab_hear_bypass"
                android:layout_marginStart="@dimen/cb_space_sm" />

            <Button
                android:id="@+id/btn_nav_modes"
                style="@style/Widget.CoreEQ.Pill"
                android:layout_marginStart="@dimen/cb_space_sm"
                tools:text="Mode: Everyday" />
        </LinearLayout>

        <!-- Measured vs correction: the flexible part of the screen. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_section"
            android:padding="8dp"
            android:layout_marginTop="@dimen/cb_space_md">

            <tv.corebuilds.eq.ui.CurveGraphView
                android:id="@+id/graph_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            style="@style/CoreEQ.Eyebrow"
            android:text="@string/platform_eq_title"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:fontFamily="monospace"
            android:textFontWeight="400"
            android:layout_marginTop="@dimen/cb_space_sm"
            android:layout_marginBottom="2dp" />

        <!-- Platform equaliser bands row -->
        <tv.corebuilds.eq.ui.BandSlidersView
            android:id="@+id/bands_home"
            android:layout_width="match_parent"
            android:layout_height="72dp" />

        <!-- 1.3.0: shown only while the HDMI output may receive Dolby/DTS as a bitstream. -->
        <TextView
            android:id="@+id/text_passthrough_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/passthrough_warning"
            android:textColor="@color/cb_warning"
            android:textSize="@dimen/cb_text_kicker"
            android:visibility="gone"
            android:layout_marginTop="@dimen/cb_space_xs" />

        <!-- 1.14.0: what is actually applied, then which listening effects are on.
             Requested and applied are said separately, never as one "Active". -->
        <TextView
            android:id="@+id/text_home_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_kicker"
            android:maxLines="4"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/cb_space_xs" />

        <!-- What the correction service last did, including every failure -->
        <TextView
            android:id="@+id/text_eq_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_correction_off"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_kicker"
            android:fontFamily="monospace"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/cb_space_xs" />
    </LinearLayout>
</tv.corebuilds.eq.ui.RailStageLayout>
