<?xml version="1.0" encoding="utf-8"?>
<!--
  Home (1.3.0): everything on one 960 x 540dp screen, no scrolling.
  The active profile and the three things changed most often (Correction,
  Mode, Re-measure) sit in one card at the top; the six other screens are a
  grouped menu on the left; the curve, the bands and what the service last
  did fill the right. The graph takes whatever height is left, so the status
  line below it is never clipped.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingLeft="@dimen/cb_gutter_side"
    android:paddingRight="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <TextView
        android:id="@+id/header_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_kicker"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_kicker"
        android:fontFamily="monospace"
        android:textAllCaps="true" />

    <!-- Update bar. GONE until the release feed names a newer build; the same
         shape as the icon pack's bar: say which version, then offer Update or
         Later. Later is remembered per version, so it does not nag. -->
    <LinearLayout
        android:id="@+id/update_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="@dimen/cb_card_padding"
        android:visibility="gone"
        android:layout_marginTop="@dimen/cb_space_sm">

        <TextView
            android:id="@+id/update_bar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_data"
            tools:text="Core EQ 1.3.1 is available" />

        <Button
            android:id="@+id/update_bar_install"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cb_target_min"
            android:minWidth="120dp"
            android:background="@drawable/bg_cta"
            android:text="@string/update_now"
            android:textColor="@color/cta_text"
            android:textSize="@dimen/cb_text_label"
            android:textStyle="bold"
            android:focusable="true"
            android:layout_marginStart="@dimen/cb_space_sm" />

        <Button
            android:id="@+id/update_bar_later"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cb_target_min"
            android:minWidth="96dp"
            android:background="@drawable/bg_ghost"
            android:text="@string/update_later"
            android:textColor="@color/ghost_text"
            android:textSize="@dimen/cb_text_label"
            android:focusable="true"
            android:layout_marginStart="@dimen/cb_space_xs" />
    </LinearLayout>

    <!-- 1.3.2: the on-screen card needs "Display over other apps", and until
         now only Profiles asked for it, so the card fell back to a text toast
         on TVs that never opened Profiles. GONE while the card can be drawn,
         while the notice is off, or once Later was pressed. Same shape as the
         update bar above. -->
    <LinearLayout
        android:id="@+id/card_permission_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="@dimen/cb_card_padding"
        android:visibility="gone"
        android:layout_marginTop="@dimen/cb_space_sm">

        <TextView
            android:id="@+id/card_permission_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_card_permission"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_data" />

        <Button
            android:id="@+id/card_permission_allow"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cb_target_min"
            android:minWidth="120dp"
            android:background="@drawable/bg_cta"
            android:text="@string/home_card_allow"
            android:textColor="@color/cta_text"
            android:textSize="@dimen/cb_text_label"
            android:textStyle="bold"
            android:focusable="true"
            android:layout_marginStart="@dimen/cb_space_sm" />

        <Button
            android:id="@+id/card_permission_later"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cb_target_min"
            android:minWidth="96dp"
            android:background="@drawable/bg_ghost"
            android:text="@string/update_later"
            android:textColor="@color/ghost_text"
            android:textSize="@dimen/cb_text_label"
            android:focusable="true"
            android:layout_marginStart="@dimen/cb_space_xs" />
    </LinearLayout>

    <!-- Active profile and its controls, one row -->
    <LinearLayout
        android:id="@+id/card_active_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="@dimen/cb_card_padding"
        android:paddingEnd="@dimen/cb_card_padding"
        android:paddingTop="@dimen/cb_space_sm"
        android:paddingBottom="@dimen/cb_space_sm"
        android:focusable="false"
        android:layout_marginTop="@dimen/cb_space_sm">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_active_profile_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/no_profile"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_section"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- Playback hint only: a configured output-mix effect plus
                     reported playback is not proof of end-to-end coverage. -->
                <LinearLayout
                    android:id="@+id/badge_correction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_idle_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginStart="@dimen/cb_space_xs"
                    android:focusable="false"
                    android:visibility="gone">

                    <View
                        android:id="@+id/badge_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="8dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/badge_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/indicator_standby"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_kicker"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_active_profile_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_profile_sub"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker"
                android:fontFamily="monospace"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_toggle_correction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cb_target_min"
            android:background="@drawable/bg_toggle"
            android:drawableEnd="@drawable/ic_switch"
            android:drawablePadding="@dimen/cb_space_sm"
            android:text="@string/correction_off"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_data"
            android:paddingStart="@dimen/cb_card_padding"
            android:paddingEnd="@dimen/cb_space_sm"
            android:focusable="true"
            android:layout_marginStart="@dimen/cb_space_md" />

        <Button
            android:id="@+id/btn_nav_modes"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cb_target_min"
            android:background="@drawable/bg_card"
            android:textColor="@color/cb_ink"
            android:textSize="@dimen/cb_text_data"
            android:paddingStart="@dimen/cb_card_padding"
            android:paddingEnd="@dimen/cb_card_padding"
            android:focusable="true"
            android:layout_marginStart="@dimen/cb_space_xs"
            tools:text="Mode: Everyday" />

        <Button
            android:id="@+id/btn_remeasure"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cb_target_min"
            android:background="@drawable/bg_cta"
            android:text="@string/action_remeasure"
            android:textColor="@color/cta_text"
            android:textSize="@dimen/cb_text_data"
            android:textStyle="bold"
            android:paddingStart="@dimen/cb_card_padding"
            android:paddingEnd="@dimen/cb_card_padding"
            android:focusable="true"
            android:layout_marginStart="@dimen/cb_space_xs" />
    </LinearLayout>

    <!-- Menu and curve -->
    <LinearLayout
        android:layout_width="match_parent"
        android:baselineAligned="false"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/cb_space_sm">

        <!-- Fits without scrolling at 540dp; the ScrollView only matters
             while the update bar is showing above it. -->
        <ScrollView
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="@dimen/cb_space_xl"
            android:layout_width="@dimen/cb_rail_width"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CoreEQ.MenuHeading"
                    android:text="@string/menu_sound" />

                <Button
                    android:id="@+id/btn_nav_manual_eq"
                    style="@style/CoreEQ.MenuRow"
                    android:text="@string/action_manual_eq" />

                <Button
                    android:id="@+id/btn_nav_extras"
                    style="@style/CoreEQ.MenuRow"
                    android:text="@string/action_extras" />

                <Button
                    android:id="@+id/btn_nav_content_type"
                    style="@style/CoreEQ.MenuRow"
                    android:text="@string/action_content_type" />

                <TextView
                    style="@style/CoreEQ.MenuHeading"
                    android:text="@string/menu_setup"
                    android:layout_marginTop="@dimen/cb_space_sm" />

                <Button
                    android:id="@+id/btn_nav_profiles"
                    style="@style/CoreEQ.MenuRow"
                    android:text="@string/action_profiles" />

                <Button
                    android:id="@+id/btn_nav_capability"
                    style="@style/CoreEQ.MenuRow"
                    android:text="@string/action_capability" />

                <Button
                    android:id="@+id/btn_nav_display_calibration"
                    style="@style/CoreEQ.MenuRow"
                    android:text="@string/action_display_calibration" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/cb_space_lg">

            <!-- Measured vs Correction graph: the flexible part of the screen -->
            <tv.corebuilds.eq.ui.CurveGraphView
                android:id="@+id/graph_home"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/platform_eq_title"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker"
                android:fontFamily="monospace"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:layout_marginBottom="4dp" />

            <!-- Platform equaliser bands row -->
            <tv.corebuilds.eq.ui.BandSlidersView
                android:id="@+id/bands_home"
                android:layout_width="match_parent"
                android:layout_height="80dp" />

            <!-- 1.3.0: shown only while the HDMI output may receive Dolby/DTS as a bitstream. -->
            <TextView
                android:id="@+id/text_passthrough_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/passthrough_warning"
                android:textColor="@color/cb_warning"
                android:textSize="@dimen/cb_text_kicker"
                android:visibility="gone"
                android:layout_marginTop="@dimen/cb_space_xs" />

            <!-- What the correction service last did, including every failure -->
            <TextView
                android:id="@+id/text_eq_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_correction_off"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker"
                android:fontFamily="monospace"
                android:maxLines="4"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/cb_space_xs" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
