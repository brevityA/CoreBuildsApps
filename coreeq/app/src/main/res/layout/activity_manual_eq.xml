<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingLeft="@dimen/cb_gutter_side"
    android:paddingRight="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manual_kicker"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_kicker"
        android:fontFamily="monospace"
        android:textAllCaps="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manual_eq_heading"
        android:textColor="@color/cb_ink"
        android:textSize="@dimen/cb_text_title"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manual_eq_subtitle"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/cb_space_md">

        <ScrollView
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="@dimen/cb_space_xl"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Which profile is being edited; the mode is on the row below. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="@dimen/cb_card_padding"
                android:paddingEnd="@dimen/cb_card_padding"
                android:paddingTop="@dimen/cb_space_sm"
                android:paddingBottom="@dimen/cb_space_sm">

                <TextView
                    android:id="@+id/text_manual_profile_kicker"
                    style="@style/CoreEQ.MenuHeading"
                    android:text="@string/manual_profile_room" />

                <TextView
                    android:id="@+id/text_manual_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/manual_eq_loading_profile"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_label"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/text_manual_profile_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="For TV speakers" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_manual_eq_mode"
                style="@style/CoreEQ.ActionRow"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:text="@string/manual_eq_edit_mode" />

            <Button
                android:id="@+id/btn_choose_eq_preset"
                style="@style/CoreEQ.ActionRow"
                android:text="@string/manual_eq_choose_preset_default" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="@dimen/cb_space_xs">

                <Button
                    android:id="@+id/btn_save_eq_preset"
                    style="@style/CoreEQ.ActionRow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:paddingStart="@dimen/cb_space_xs"
                    android:paddingEnd="@dimen/cb_space_xs"
                    android:text="@string/manual_eq_save_preset" />

                <Button
                    android:id="@+id/btn_reset_eq"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/cb_target_min"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/cb_space_xs"
                    android:background="@drawable/bg_ghost"
                    android:text="@string/manual_eq_reset"
                    android:textColor="@color/cb_signal_cyan"
                    android:textSize="@dimen/cb_text_data"
                    android:focusable="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_import_eq_file"
                style="@style/CoreEQ.ActionRow"
                android:text="@string/manual_eq_import_file" />

            <TextView
                android:id="@+id/text_manual_headroom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:text="@string/manual_eq_headroom_pending"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_kicker"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/text_manual_eq_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:maxLines="3"
                android:ellipsize="end"
                android:text="@string/manual_eq_apply_hint"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker" />

            <Button
                android:id="@+id/btn_manual_eq_done"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:background="@drawable/bg_cta"
                android:text="@string/manual_eq_done"
                android:textColor="@color/cta_text"
                android:textSize="@dimen/cb_text_label"
                android:textStyle="bold"
                android:focusable="true" />
        </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cb_space_lg"
            android:orientation="vertical">

            <tv.corebuilds.eq.ui.CurveGraphView
                android:id="@+id/graph_manual_eq"
                android:layout_width="match_parent"
                android:layout_height="145dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:text="@string/manual_eq_band_caption"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker"
                android:fontFamily="monospace" />

            <tv.corebuilds.eq.ui.ManualEqBandsView
                android:id="@+id/manual_eq_bands"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:contentDescription="@string/manual_eq_dpad_help" />

            <TextView
                android:id="@+id/text_manual_selected_band"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:text="@string/manual_eq_dpad_help"
                android:textColor="@color/cb_slate"
                android:textSize="@dimen/cb_text_kicker"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
