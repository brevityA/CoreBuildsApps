<?xml version="1.0" encoding="utf-8"?>
<tv.corebuilds.eq.ui.RailStageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/cb_night">

<include layout="@layout/view_rail" />

<LinearLayout
    android:id="@+id/stage"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/cb_stage_start"
    android:paddingEnd="@dimen/cb_stage_end"
    android:paddingTop="@dimen/cb_stage_top"
    android:paddingBottom="@dimen/cb_stage_bottom"
    android:clipToPadding="false"
    android:clipChildren="false">

    <TextView
        style="@style/CoreEQ.Title"
        android:text="@string/capability_heading" />

    <TextView
        style="@style/CoreEQ.Lede"
        android:text="@string/capability_sub"
        android:layout_marginTop="4dp" />

    <!-- Two-pane content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:layout_marginTop="@dimen/cb_space_md">

        <!-- Left column: the probed paths, scroll-bounded so an added row can
             never clip on a 540dp panel -->
        <ScrollView
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="@dimen/cb_space_xl"
            android:layout_width="336dp"
            android:layout_height="match_parent"
            android:clipToPadding="true"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Global session 0 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/cb_card_padding"
                android:focusable="true"
                android:stateListAnimator="@animator/focus_raise"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cap_global_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_data"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/status_session0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Deprecated in 2012, never removed. Probing..."
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Row 2: session/playback signals trigger rescans only -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/cb_card_padding"
                android:focusable="true"
                android:stateListAnimator="@animator/focus_raise"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cap_signals_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_data"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cap_signals_note"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Row 3: DUMP discovery (optional, ladder rung 2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/cb_card_padding"
                android:focusable="true"
                android:stateListAnimator="@animator/focus_raise"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/capability_discovery_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_data"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/status_discovery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/capability_discovery_granted"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/text_discovery_command"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/capability_discovery_command"
                    android:textColor="@color/cb_signal_cyan"
                    android:textSize="@dimen/cb_text_kicker"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Row 4: This app's own playback -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/cb_card_padding"
                android:focusable="true"
                android:stateListAnimator="@animator/focus_raise"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cap_own_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_data"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cap_own_note"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Row 5: DynamicsProcessing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/cb_card_padding"
                android:focusable="true"
                android:stateListAnimator="@animator/focus_raise"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cap_dp_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_data"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/status_dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Your own band layout, up to 31 bands, plus a limiter."
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Row 6: Platform Equalizer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/cb_card_padding"
                android:focusable="true"
                android:stateListAnimator="@animator/focus_raise">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cap_eq_title"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_data"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/status_platform_eq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Device reports its own bands and millibel range. Always present."
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Row 7: App updates. Same release feed the other Core apps poll;
                 the card exists so a user can ask for a check on a build whose
                 automatic check is off, and so the test channel can say why it
                 has no feed instead of silently never offering one. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section"
                android:padding="@dimen/cb_card_padding"
                android:layout_marginTop="@dimen/cb_space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_title"
                    android:textColor="@color/cb_signal_cyan"
                    android:textSize="@dimen/cb_text_kicker"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/text_update_installed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_data"
                    android:textFontWeight="600"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/text_update_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp" />

                <Button
                    android:id="@+id/btn_check_update"
                    style="@style/Widget.CoreEQ.Pill.Ghost"
                    android:layout_width="match_parent"
                    android:stateListAnimator="@animator/focus_raise"
                    android:text="@string/update_check_now"
                    android:layout_marginTop="@dimen/cb_space_sm" />

                <Button
                    android:id="@+id/btn_install_update"
                    style="@style/Widget.CoreEQ.Pill.Cta"
                    android:layout_width="match_parent"
                    android:stateListAnimator="@animator/focus_raise"
                    android:text="@string/update_now"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/cb_space_xs" />

                <Button
                    android:id="@+id/btn_update_auto"
                    style="@style/CoreEQ.SwitchRow"
                    android:textSize="@dimen/cb_text_data"
                    android:text="@string/update_auto_on" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_note"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="@dimen/cb_space_xs" />
            </LinearLayout>

            <!-- Row 8: Support. Here beside the installed build rather than on
                 Home, whose menu has no row to spare at 540dp. Opens the two
                 QR codes; this card itself shows no code and sends nothing. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section"
                android:padding="@dimen/cb_card_padding"
                android:layout_marginTop="@dimen/cb_space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_card_title"
                    android:textColor="@color/cb_signal_cyan"
                    android:textSize="@dimen/cb_text_kicker"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:textFontWeight="600" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_card_note"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btn_open_support"
                    style="@style/Widget.CoreEQ.Pill.Ghost"
                    android:layout_width="match_parent"
                    android:stateListAnimator="@animator/focus_raise"
                    android:text="@string/action_support"
                    android:layout_marginTop="@dimen/cb_space_sm" />

                <!-- 1.14.0: a summary for a bug report, built only when pressed,
                     shown in full before it can be copied or shown as a QR code.
                     Nothing is sent. -->
                <Button
                    android:id="@+id/btn_diagnostics"
                    style="@style/Widget.CoreEQ.Pill.Ghost"
                    android:layout_width="match_parent"
                    android:stateListAnimator="@animator/focus_raise"
                    android:text="@string/action_diagnostics"
                    android:layout_marginTop="@dimen/cb_space_xs" />
            </LinearLayout>

        </LinearLayout>

        </ScrollView>

        <!-- Right pane: Verdict card + Fallback guidance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clipChildren="false"
            android:layout_marginStart="@dimen/cb_space_md">

            <!-- Verdict card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section"
                android:padding="@dimen/cb_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/capability_verdict_title"
                    android:textColor="@color/cb_signal_cyan"
                    android:textSize="@dimen/cb_text_kicker"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/text_verdict_bands"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="5 bands"
                    android:textColor="@color/cb_ink"
                    android:textSize="26sp"
                    android:textFontWeight="600"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/text_verdict_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="app identity: DUMP not granted"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/text_verdict_global"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="global mix: not supported"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cap_verdict_note"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="@dimen/cb_space_xs" />
            </LinearLayout>

            <TextView
                style="@style/CoreEQ.MenuHeading"
                android:text="@string/capability_fallback_title"
                android:layout_marginTop="@dimen/cb_space_md" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/capability_fallback_desc"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_export_tv_settings"
                style="@style/Widget.CoreEQ.Pill.Cta"
                android:text="@string/action_tv_export"
                android:layout_marginTop="@dimen/cb_space_sm" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
</tv.corebuilds.eq.ui.RailStageLayout>
