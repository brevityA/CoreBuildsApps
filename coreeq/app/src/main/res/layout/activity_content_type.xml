<?xml version="1.0" encoding="utf-8"?>
<!-- Content type (rail and stage since 1.12.0). Fits the stage without
     scrolling at the default text size. The ScrollView is for a TV whose
     system text size is turned up: the chips and Done then scroll into view
     as the D-pad reaches them, instead of sitting below the screen with no
     way to reach them. -->
<tv.corebuilds.eq.ui.RailStageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/cb_night">

<include layout="@layout/view_rail" />

<ScrollView
    android:id="@+id/stage"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:requiresFadingEdge="vertical"
    android:fadingEdgeLength="@dimen/cb_space_xl"
    android:scrollbars="none">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/cb_stage_start"
    android:paddingEnd="@dimen/cb_stage_end"
    android:paddingTop="@dimen/cb_stage_top"
    android:paddingBottom="@dimen/cb_stage_bottom"
    android:clipToPadding="false"
    android:clipChildren="false">

    <TextView
        style="@style/CoreEQ.Title"
        android:text="@string/content_type_heading" />

    <TextView
        style="@style/CoreEQ.Lede"
        android:text="@string/content_type_subtitle"
        android:layout_marginTop="4dp" />

    <!-- Current selection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_section"
        android:paddingStart="@dimen/cb_space_md"
        android:paddingEnd="@dimen/cb_space_md"
        android:paddingTop="@dimen/cb_space_sm"
        android:paddingBottom="@dimen/cb_space_sm"
        android:layout_marginTop="@dimen/cb_space_md">

        <TextView
            android:id="@+id/text_content_type_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cb_signal_cyan"
            android:textSize="@dimen/cb_text_section"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/text_content_type_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_data"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/text_auto_detect_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cb_slate"
            android:textSize="@dimen/cb_text_kicker"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Content types: two rows of five, the selected one filled (activated).
         Labels come from ContentType.title, so the screen and the enum cannot drift. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:layout_marginTop="@dimen/cb_space_md">

        <Button
            android:id="@+id/btn_content_movie"
            style="@style/CoreEQ.Chip"
            tools:text="Movies" />

        <Button
            android:id="@+id/btn_content_anime"
            style="@style/CoreEQ.Chip"
            android:layout_marginStart="@dimen/cb_space_xs"
            tools:text="Anime" />

        <Button
            android:id="@+id/btn_content_tv"
            style="@style/CoreEQ.Chip"
            android:layout_marginStart="@dimen/cb_space_xs"
            tools:text="TV Shows" />

        <Button
            android:id="@+id/btn_content_sitcom"
            style="@style/CoreEQ.Chip"
            android:layout_marginStart="@dimen/cb_space_xs"
            tools:text="Sitcoms" />

        <Button
            android:id="@+id/btn_content_documentary"
            style="@style/CoreEQ.Chip"
            android:layout_marginStart="@dimen/cb_space_xs"
            tools:text="Documentaries" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:layout_marginTop="@dimen/cb_space_xs">

        <Button
            android:id="@+id/btn_content_news"
            style="@style/CoreEQ.Chip"
            tools:text="News / Live" />

        <Button
            android:id="@+id/btn_content_podcast"
            style="@style/CoreEQ.Chip"
            android:layout_marginStart="@dimen/cb_space_xs"
            tools:text="Podcasts" />

        <Button
            android:id="@+id/btn_content_gaming"
            style="@style/CoreEQ.Chip"
            android:layout_marginStart="@dimen/cb_space_xs"
            tools:text="Gaming" />

        <Button
            android:id="@+id/btn_content_music"
            style="@style/CoreEQ.Chip"
            android:layout_marginStart="@dimen/cb_space_xs"
            tools:text="Music" />

        <Button
            android:id="@+id/btn_content_general"
            style="@style/CoreEQ.Chip"
            android:layout_marginStart="@dimen/cb_space_xs"
            tools:text="Everyday" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:layout_marginTop="@dimen/cb_space_md">

        <Button
            android:id="@+id/btn_content_auto"
            style="@style/Widget.CoreEQ.Pill.Switch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:stateListAnimator="@animator/focus_raise"
            tools:text="Auto-detect: On" />

        <Button
            android:id="@+id/btn_content_done"
            style="@style/Widget.CoreEQ.Pill.Cta"
            android:minWidth="160dp"
            android:text="@string/mode_done"
            android:layout_marginStart="@dimen/cb_space_sm" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
</tv.corebuilds.eq.ui.RailStageLayout>
