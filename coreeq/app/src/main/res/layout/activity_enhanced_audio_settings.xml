<?xml version="1.0" encoding="utf-8"?>
<!-- Extra effects (1.2.1; dialogue and low-volume bass since 1.3.0; stereo
     speakers since 1.10.0; rail and stage since 1.12.0). Seven switches, all
     off by default, applied the moment they change: one list on the left, and
     a panel on the right that explains whichever has focus, the Android TV
     settings pattern. Since 1.12.0 only the list scrolls; the panel stays
     where it is, so the explanation never scrolls away from the switch it
     describes. When an explanation is longer than the panel, the panel takes
     focus on Right (the ring shows) and scrolls on Up and Down. -->
<tv.corebuilds.eq.ui.RailStageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/cb_night">

    <include layout="@layout/view_rail" />

    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/cb_stage_start"
        android:paddingEnd="@dimen/cb_stage_end"
        android:paddingTop="@dimen/cb_stage_top"
        android:paddingBottom="@dimen/cb_stage_bottom">

        <TextView
            style="@style/CoreEQ.Title"
            android:text="@string/extras_heading" />

        <TextView
            style="@style/CoreEQ.Lede"
            android:text="@string/extras_subtitle"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="@dimen/cb_space_md">

            <!-- The switches, grouped by what they change. This column scrolls. -->
            <ScrollView
                android:layout_width="296dp"
                android:layout_height="match_parent"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:clipToPadding="true"
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="@dimen/cb_space_xl"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CoreEQ.MenuHeading"
                        android:paddingStart="4dp"
                        android:text="@string/extras_group_tone" />

                    <Button
                        android:id="@+id/btn_extras_stereo"
                        style="@style/CoreEQ.SwitchRow"
                        android:layout_marginTop="6dp"
                        tools:text="Stereo speakers: Off" />

                    <Button
                        android:id="@+id/btn_extras_dialogue"
                        style="@style/CoreEQ.SwitchRow"
                        tools:text="Dialogue boost: Off" />

                    <Button
                        android:id="@+id/btn_extras_low_bass"
                        style="@style/CoreEQ.SwitchRow"
                        tools:text="Low-volume bass: Off" />

                    <Button
                        android:id="@+id/btn_extras_bass"
                        style="@style/CoreEQ.SwitchRow"
                        tools:text="Bass boost: Off" />

                    <TextView
                        style="@style/CoreEQ.MenuHeading"
                        android:paddingStart="4dp"
                        android:text="@string/extras_group_level"
                        android:layout_marginTop="@dimen/cb_space_md" />

                    <Button
                        android:id="@+id/btn_extras_loudness"
                        style="@style/CoreEQ.SwitchRow"
                        android:layout_marginTop="6dp"
                        tools:text="Loudness enhancer: Off" />

                    <Button
                        android:id="@+id/btn_extras_night"
                        style="@style/CoreEQ.SwitchRow"
                        tools:text="Night mode: Off" />

                    <Button
                        android:id="@+id/btn_extras_auto_loudness"
                        style="@style/CoreEQ.SwitchRow"
                        tools:text="Auto loudness: Off" />
                </LinearLayout>
            </ScrollView>

            <!-- What the focused switch does; follows focus, stays put. -->
            <ScrollView
                android:id="@+id/scroll_extras_detail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/cb_space_md"
                android:background="@drawable/bg_section_focusable"
                android:padding="@dimen/cb_space_md"
                android:clipToPadding="true"
                android:focusable="false"
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="@dimen/cb_space_xl"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:accessibilityLiveRegion="polite">

                    <TextView
                        android:id="@+id/text_extras_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cb_signal_cyan"
                        android:textSize="@dimen/cb_text_label"
                        android:textFontWeight="600"
                        android:accessibilityHeading="true"
                        tools:text="Dialogue boost" />

                    <TextView
                        android:id="@+id/text_extras_detail_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cb_space_xs"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_data"
                        android:lineSpacingExtra="2dp"
                        tools:text="@string/extras_dialogue_note" />

                    <TextView
                        android:id="@+id/text_extras_detail_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cb_space_sm"
                        android:textColor="@color/cb_glow_cyan"
                        android:textSize="@dimen/cb_text_kicker"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:visibility="gone"
                        tools:text="This output: reference -12 dB, now -22 dB, +1.5 dB under 100 Hz."
                        tools:visibility="visible" />

                    <!-- Shown only while the explanation runs past the panel. -->
                    <TextView
                        android:id="@+id/text_extras_detail_more"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cb_space_sm"
                        android:text="@string/extras_detail_more"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_kicker"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</tv.corebuilds.eq.ui.RailStageLayout>
