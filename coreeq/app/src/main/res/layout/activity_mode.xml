<?xml version="1.0" encoding="utf-8"?>
<!--
  Content modes (rail and stage since 1.12.0). Opened from Home's Mode pill,
  so no rail item is marked; Left from the stage's edge goes to the rail's
  first item. The controls are one column on the left; the right explains how
  automatic switching works and lists the app rules.
-->
<tv.corebuilds.eq.ui.RailStageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/cb_night">

    <include layout="@layout/view_rail" />

    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/cb_stage_start"
        android:paddingEnd="@dimen/cb_stage_end"
        android:paddingTop="@dimen/cb_stage_top"
        android:paddingBottom="@dimen/cb_stage_bottom"
        android:clipToPadding="false"
        android:clipChildren="false">

        <TextView
            style="@style/CoreEQ.Title"
            android:text="@string/mode_heading" />

        <TextView
            style="@style/CoreEQ.Lede"
            android:text="@string/mode_subtitle"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="@dimen/cb_space_md">

            <ScrollView
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="@dimen/cb_space_xl"
                android:layout_width="316dp"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="true"
                android:paddingTop="2dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_mode_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cb_signal_cyan"
                        android:textSize="@dimen/cb_text_data"
                        android:fontFamily="monospace"
                        android:paddingStart="4dp" />

                    <!-- The three modes as one segmented control (1.12.0); the
                         chosen one is cyan (activated). -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:background="@drawable/bg_segment_track"
                        android:padding="4dp"
                        android:layout_marginTop="@dimen/cb_space_sm">

                        <Button
                            android:id="@+id/btn_mode_movie"
                            style="@style/Widget.CoreEQ.Segment"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:stateListAnimator="@animator/focus_raise"
                            android:text="@string/mode_movie_tv" />

                        <Button
                            android:id="@+id/btn_mode_everyday"
                            style="@style/Widget.CoreEQ.Segment"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:stateListAnimator="@animator/focus_raise"
                            android:text="@string/mode_everyday"
                            android:layout_marginStart="2dp" />

                        <Button
                            android:id="@+id/btn_mode_gaming"
                            style="@style/Widget.CoreEQ.Segment"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:stateListAnimator="@animator/focus_raise"
                            android:text="@string/mode_gaming"
                            android:layout_marginStart="2dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_auto_mode"
                        style="@style/CoreEQ.SwitchRow"
                        android:layout_marginTop="@dimen/cb_space_md"
                        android:text="@string/mode_auto_off" />

                    <Button
                        android:id="@+id/btn_mode_override_policy"
                        style="@style/CoreEQ.ActionRow"
                        android:text="@string/mode_override_temporary" />

                    <Button
                        android:id="@+id/btn_mode_media_access"
                        style="@style/CoreEQ.ActionRow"
                        android:background="@drawable/bg_pill_ghost"
                        android:textColor="@color/pill_ghost_text"
                        android:text="@string/mode_media_access_off" />

                    <Button
                        android:id="@+id/btn_mode_manage_apps"
                        style="@style/CoreEQ.ActionRow"
                        android:background="@drawable/bg_pill_ghost"
                        android:textColor="@color/pill_ghost_text"
                        android:text="@string/mode_manage_apps" />

                    <Button
                        android:id="@+id/btn_mode_done"
                        style="@style/CoreEQ.ActionRow"
                        android:layout_marginTop="@dimen/cb_space_md"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_cta"
                        android:textColor="@color/cta_text"
                        android:textFontWeight="700"
                        android:text="@string/mode_done" />
                </LinearLayout>
            </ScrollView>

            <!-- How automatic switching works, and the app rules. The panel is
                 its own viewport: Right from the column enters it (the ring
                 shows), Up and Down scroll it, Left leaves. -->
            <ScrollView
                android:id="@+id/scroll_mode_rules"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/cb_space_md"
                android:background="@drawable/bg_section_focusable"
                android:padding="@dimen/cb_space_md"
                android:clipToPadding="true"
                android:fillViewport="true"
                android:focusable="true"
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="@dimen/cb_space_xl"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CoreEQ.MenuHeading"
                        android:text="@string/mode_rules_heading" />

                    <TextView
                        android:id="@+id/text_mode_rules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cb_space_xs"
                        android:text="@string/mode_app_rules_hint"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_data"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</tv.corebuilds.eq.ui.RailStageLayout>
