<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cb_night"
    android:paddingLeft="@dimen/cb_gutter_side"
    android:paddingRight="@dimen/cb_gutter_side"
    android:paddingTop="@dimen/cb_gutter_top"
    android:paddingBottom="@dimen/cb_gutter_bottom">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_title"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_kicker"
        android:fontFamily="monospace"
        android:textAllCaps="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_heading"
        android:textColor="@color/cb_ink"
        android:textSize="@dimen/cb_text_title"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_subtitle"
        android:textColor="@color/cb_slate"
        android:textSize="@dimen/cb_text_data"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/cb_space_md">

        <ScrollView
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_mode_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="@dimen/cb_card_padding"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_data"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btn_mode_movie"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:background="@drawable/bg_chip_toggle"
                android:text="@string/mode_movie_tv"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_mode_everyday"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:background="@drawable/bg_chip_toggle"
                android:text="@string/mode_everyday"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_mode_gaming"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:background="@drawable/bg_chip_toggle"
                android:text="@string/mode_gaming"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_auto_mode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginTop="@dimen/cb_space_md"
                android:background="@drawable/bg_card"
                android:text="@string/mode_auto_off"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                android:gravity="start|center_vertical"
                android:paddingStart="@dimen/cb_card_padding"
                android:paddingEnd="@dimen/cb_card_padding"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_mode_override_policy"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:background="@drawable/bg_card"
                android:text="@string/mode_override_temporary"
                android:textColor="@color/cb_ink"
                android:textSize="@dimen/cb_text_data"
                android:gravity="start|center_vertical"
                android:paddingStart="@dimen/cb_card_padding"
                android:paddingEnd="@dimen/cb_card_padding"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_mode_manage_apps"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginTop="@dimen/cb_space_xs"
                android:background="@drawable/bg_ghost"
                android:text="@string/mode_manage_apps"
                android:textColor="@color/cb_signal_cyan"
                android:textSize="@dimen/cb_text_data"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_mode_done"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cb_target_min"
                android:layout_marginTop="@dimen/cb_space_sm"
                android:background="@drawable/bg_cta"
                android:text="@string/mode_done"
                android:textColor="@color/cb_cta_ink"
                android:textSize="@dimen/cb_text_label"
                android:textStyle="bold"
                android:focusable="true" />
        </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cb_space_lg"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">
                <TextView
                    android:id="@+id/text_mode_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="@dimen/cb_card_padding"
                    android:gravity="top|start"
                    android:text="@string/mode_app_rules_hint"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_data" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
