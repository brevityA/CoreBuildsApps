<?xml version="1.0" encoding="utf-8"?>
<!--
  Profiles (rail and stage since 1.12.0). Left: the saved profiles, then what
  happens when one is applied, in one column that scrolls. Until 1.12.0 the
  list shared a fixed-height column with eight controls; at 540dp the
  controls took all of it, the list got no height at all and the last button
  sat below the screen. Right: the chosen profile's curve and its export.
-->
<tv.corebuilds.eq.ui.RailStageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/cb_night">

    <include layout="@layout/view_rail" />

    <LinearLayout
        android:id="@+id/stage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/cb_stage_start"
        android:paddingEnd="@dimen/cb_stage_end"
        android:paddingTop="@dimen/cb_stage_top"
        android:paddingBottom="@dimen/cb_stage_bottom"
        android:clipToPadding="false"
        android:clipChildren="false">

        <TextView
            style="@style/CoreEQ.Title"
            android:text="@string/profiles_heading" />

        <TextView
            style="@style/CoreEQ.Lede"
            android:text="@string/profiles_sub"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:layout_marginTop="@dimen/cb_space_md">

            <ScrollView
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="@dimen/cb_space_xl"
                android:layout_width="284dp"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="true"
                android:paddingTop="2dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CoreEQ.MenuHeading"
                        android:paddingStart="4dp"
                        android:paddingBottom="6dp"
                        android:text="@string/profiles_list_heading" />

                    <!-- Every saved profile; the column scrolls, the list does not. -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_profiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <!-- 1.14.0: whether the chosen profile plays on the output in use
                         (it was a toast), then what can be done with it. -->
                    <TextView
                        android:id="@+id/text_profile_route"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/cb_ink"
                        android:textSize="@dimen/cb_text_kicker"
                        android:layout_marginTop="@dimen/cb_space_xs" />

                    <Button
                        android:id="@+id/btn_profile_details"
                        style="@style/CoreEQ.ActionRow"
                        android:text="@string/action_profile_details" />

                    <Button
                        android:id="@+id/btn_profile_rename"
                        style="@style/CoreEQ.ActionRow"
                        android:text="@string/action_profile_rename" />

                    <Button
                        android:id="@+id/btn_profile_duplicate"
                        style="@style/CoreEQ.ActionRow"
                        android:text="@string/action_profile_duplicate" />

                    <TextView
                        style="@style/CoreEQ.MenuHeading"
                        android:paddingStart="4dp"
                        android:layout_marginTop="@dimen/cb_space_md"
                        android:text="@string/profiles_notice_heading" />

                    <!-- 1.3.0: the on-screen card (or, without the overlay permission,
                         a toast) the service shows when a profile is applied. -->
                    <Button
                        android:id="@+id/btn_announce_applied"
                        style="@style/CoreEQ.SwitchRow"
                        android:textSize="@dimen/cb_text_data"
                        android:text="@string/profiles_announce_on" />

                    <!-- How long the card stays up: 1 to 10 seconds, cycled on each press. -->
                    <Button
                        android:id="@+id/btn_card_seconds"
                        style="@style/CoreEQ.ActionRow"
                        android:text="@string/profiles_card_seconds" />

                    <!-- How the notice shows on this TV, and the way to the card when
                         "Display over other apps" is not allowed yet. -->
                    <TextView
                        android:id="@+id/text_announce_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cb_space_xs"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_kicker"
                        tools:text="Shown as a card at the top right for 4 seconds, over whatever is playing." />

                    <!-- Optional persistent playback status, independent of the one-shot applied notice. -->
                    <Button
                        android:id="@+id/btn_playback_hud"
                        style="@style/CoreEQ.SwitchRow"
                        android:textSize="@dimen/cb_text_data"
                        android:layout_marginTop="@dimen/cb_space_sm"
                        android:text="@string/profiles_playback_hud_off" />

                    <TextView
                        android:id="@+id/text_playback_hud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cb_space_xs"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/cb_slate"
                        android:textSize="@dimen/cb_text_kicker"
                        tools:text="A touch-through chip stays up while Android reports playback; it does not prove the audio route." />

                    <Button
                        android:id="@+id/btn_allow_overlay"
                        style="@style/CoreEQ.ActionRow"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_ghost"
                        android:textColor="@color/pill_ghost_text"
                        android:visibility="gone"
                        android:text="@string/profiles_card_allow" />

                    <!-- Preview the card on this TV: the service shows it for what is
                         applied now, without switching correction off and on. -->
                    <Button
                        android:id="@+id/btn_test_card"
                        style="@style/CoreEQ.ActionRow"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_ghost"
                        android:textColor="@color/pill_ghost_text"
                        android:text="@string/profiles_card_test" />

                    <!-- What Core EQ has learned: the profile it prefers for each output,
                         based on the user's own choices. Can be cleared here. -->
                    <Button
                        android:id="@+id/btn_learned_prefs"
                        style="@style/CoreEQ.ActionRow"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_ghost"
                        android:textColor="@color/pill_ghost_text"
                        android:text="@string/profiles_learned_prefs" />
                </LinearLayout>
            </ScrollView>

            <!-- The chosen profile: its curve, its export. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:clipChildren="false"
                android:layout_marginStart="@dimen/cb_space_md">

                <!-- Takes the height the export controls leave, so Export and
                     Delete are always on screen. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_section"
                    android:padding="6dp">

                    <tv.corebuilds.eq.ui.CurveGraphView
                        android:id="@+id/graph_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <TextView
                    style="@style/CoreEQ.MenuHeading"
                    android:text="@string/export_title"
                    android:layout_marginTop="@dimen/cb_space_sm" />

                <!-- Export format chips, two by two -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:clipChildren="false"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/chip_parametric"
                        style="@style/CoreEQ.Chip"
                        android:layout_height="@dimen/cb_pill_compact"
                        android:text="@string/export_chip_parametric" />

                    <Button
                        android:id="@+id/chip_graphiceq"
                        style="@style/CoreEQ.Chip"
                        android:layout_height="@dimen/cb_pill_compact"
                        android:layout_marginStart="@dimen/cb_space_xs"
                        android:text="@string/export_chip_graphiceq" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:clipChildren="false"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/chip_json"
                        style="@style/CoreEQ.Chip"
                        android:layout_height="@dimen/cb_pill_compact"
                        android:text="@string/export_chip_json" />

                    <Button
                        android:id="@+id/chip_poweramp_json"
                        style="@style/CoreEQ.Chip"
                        android:layout_height="@dimen/cb_pill_compact"
                        android:layout_marginStart="@dimen/cb_space_xs"
                        android:text="@string/export_chip_poweramp_json" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_preamp_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Parametric preamp −3.72 dB · Everyday · HDMI"
                    android:textColor="@color/cb_ink"
                    android:textSize="@dimen/cb_text_kicker"
                    android:fontFamily="monospace"
                    android:layout_marginTop="@dimen/cb_space_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_preamp_desc"
                    android:textColor="@color/cb_slate"
                    android:textSize="@dimen/cb_text_kicker"
                    android:layout_marginTop="2dp" />

                <!-- Export, Import and Delete -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:layout_marginTop="@dimen/cb_space_sm">

                    <Button
                        android:id="@+id/btn_export_profile"
                        style="@style/Widget.CoreEQ.Pill.Cta"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/action_export" />

                    <Button
                        android:id="@+id/btn_import_profile"
                        style="@style/Widget.CoreEQ.Pill.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1.2"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="@dimen/cb_space_xs"
                        android:text="@string/action_import_profile" />

                    <Button
                        android:id="@+id/btn_delete_profile"
                        style="@style/Widget.CoreEQ.Pill.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="@dimen/cb_space_xs"
                        android:textColor="@color/cb_ember"
                        android:text="@string/action_delete" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</tv.corebuilds.eq.ui.RailStageLayout>
