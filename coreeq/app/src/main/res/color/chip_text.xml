<?xml version="1.0" encoding="utf-8"?>
<!-- Chip label: dark ink on the filled (activated) cyan chip, light ink otherwise;
     cyan on a disabled chosen chip's tint, dimmed on the rest of a disabled row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_enabled="false" android:color="@color/cb_signal_cyan" />
    <item android:state_enabled="false" android:color="@color/cb_text_disabled" />
    <item android:state_activated="true" android:color="@color/cb_cta_ink" />
    <item android:color="@color/cb_ink" />
</selector>
