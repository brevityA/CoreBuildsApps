<?xml version="1.0" encoding="utf-8"?>
<!-- A rail icon: cyan on the current screen, ink under focus, slate at rest. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:color="@color/cb_signal_cyan" />
    <item android:state_focused="true" android:color="@color/cb_ink" />
    <item android:color="@color/cb_slate" />
</selector>
