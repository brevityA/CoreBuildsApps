<?xml version="1.0" encoding="utf-8"?>
<!-- One option in a segmented control: cyan when chosen, ink under focus, slate otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:color="@color/cb_signal_cyan" />
    <item android:state_focused="true" android:color="@color/cb_ink" />
    <item android:color="@color/cb_slate" />
</selector>
